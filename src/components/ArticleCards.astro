---
const {items}=Astro.props;
import {blogTopics} from '../data/blog-topics';
---
<div class="article-grid">{items.map((a:any)=><a class="article-card" href={`/${a.data.category}/${a.id}/`}><span class="eyebrow">{a.data.category==='guides'?'操作教程':a.data.category==='glossary'?'知识百科':blogTopics.find(t=>t.id===a.data.section)?.name??'博客文章'} · 约 {Math.max(2,Math.ceil((a.body?.length??600)/400))} 分钟</span><h3>{a.data.title}</h3><p>{a.data.description}</p><span class="small muted">{a.data.updated.toISOString().slice(0,10)} <span class="float-right">阅读文章 ↗</span></span></a>)}</div>
