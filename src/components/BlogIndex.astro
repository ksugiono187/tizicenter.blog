---
import ArticleCards from './ArticleCards.astro';
import {blogTopics} from '../data/blog-topics';
import {orderArticles} from '../data/editorial';
import Icon from './Icon.astro';
import type {CollectionEntry} from 'astro:content';
interface Props {items:CollectionEntry<'articles'>[];page?:number;section?:string}
const {items,page=1,section}=Astro.props;
const size=15;
const ordered=orderArticles(items);
const filtered=section?ordered.filter(a=>a.data.section===section):ordered;
const count=filtered.length;
const pages=Math.ceil(count/size);
const visible=filtered.slice((page-1)*size,page*size);
const topic=blogTopics.find(t=>t.id===section);
const href=(n:number)=>section?`/blog/topic/${section}/${n===1?'':`page/${n}/`}`:n===1?'/blog/':`/blog/page/${n}/`;
---
<div class="blog-library">
 <div class="library-toolbar"><div><span class="eyebrow">{topic?'专题阅读':'按问题查找 · 持续整理'}</span><h2>{topic?topic.name:'从一个问题，找到下一步。'}</h2><p>{topic?topic.description:`${items.length} 篇文章 · ${blogTopics.length} 个主题 · 选购、使用与排查`}</p></div><form class="library-search" action="/search/" method="get" role="search"><input type="hidden" name="scope" value="blog"/><label class="sr-only" for="blog-query">搜索博客文章</label><Icon name="search" size={18}/><input id="blog-query" type="search" name="q" placeholder="搜索：流量、订阅、连接…" autocomplete="off"/><button type="submit" aria-label="提交博客搜索"><Icon name="arrow" size={18}/></button></form></div>
 <details class="topic-picker" open><summary><span><Icon name="grid" size={16}/>按主题筛选</span><strong>{topic?topic.name:'全部文章'} · {count} 篇</strong></summary><nav class="blog-topics" aria-label="博客主题"><a class:list={{selected:!section}} href="/blog/" aria-current={!section?'page':undefined}><strong>全部文章</strong><span>{items.length}</span></a>{blogTopics.map(t=><a class:list={{selected:section===t.id}} href={`/blog/topic/${t.id}/`} aria-current={section===t.id?'page':undefined}><strong>{t.name}</strong><span>{items.filter((a:any)=>a.data.section===t.id).length}</span></a>)}</nav></details>
 {!section&&page===1&&<div class="editorial-starts">{[['wallet','购买之前','先把需求与账单看清楚','/blog/purchase-checklist/'],['book','订阅配置','选对格式，再启用配置','/blog/subscription-format-choice/'],['activity','遇到故障','从正常网络基线开始排查','/guides/connection-troubleshooting/']].map(([icon,title,desc,url])=><a href={url}><span class="start-icon"><Icon name={icon} size={21}/></span><div><strong>{title}</strong><small>{desc}</small></div><Icon name="arrow" size={16}/></a>)}</div>}
 <div class="blog-list-head"><p>共 {count} 篇 · 第 {page} / {pages} 页 · 当前显示 {(page-1)*size+1}–{Math.min(page*size,count)} 篇</p><span class="small muted">更新优先 · 同日文章按阅读顺序整理</span></div>
 <ArticleCards items={visible}/>
 <nav class="pagination" aria-label="博客分页">{page>1&&<a href={href(page-1)} rel="prev">← 上一页</a>}{Array.from({length:pages},(_,i)=>i+1).map(n=><a href={href(n)} aria-label={`第 ${n} 页`} aria-current={page===n?'page':undefined}>{n}</a>)}{page<pages&&<a href={href(page+1)} rel="next">下一页 →</a>}</nav>
 <p class="section-note">计算情境均明确标注；操作清单为编辑方法。技术说明附出处，品牌价格、优惠和性能仍以可核实资料为准。</p>
</div>
<script>
 const breakpoint=matchMedia('(min-width: 901px)');
 const pickers=[...document.querySelectorAll<HTMLDetailsElement>('.topic-picker')];
 const adapt=()=>pickers.forEach(picker=>{picker.open=breakpoint.matches;});
 adapt();breakpoint.addEventListener('change',adapt);
</script>
