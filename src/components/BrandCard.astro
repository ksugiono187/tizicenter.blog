---
import {price,traffic,unknown} from '../data/airports';
const {airport:a}=Astro.props;
---
<article class="brand-card"><div class="brand-top"><span class={`brand-icon ${a.id}`}>{a.name.slice(0,1)}</span><span class="badge">官方资料 · VPN</span></div><h3><a href={`/airport/${a.slug}/`}>{a.name}</a></h3><p>{a.description}</p><dl class="metrics"><div><dt>起步价格</dt><dd>{price(a)}</dd></div><div><dt>套餐流量</dt><dd>{traffic(a)}</dd></div><div><dt>线路类型</dt><dd>{a.lineType??unknown}</dd></div></dl><p class="small"><strong>适合：</strong>{a.suitableFor.join('、')}</p><p class="small"><strong>优势：</strong>{a.advantages[0]}</p><p class="small muted"><strong>留意：</strong>{a.disadvantages[0]}</p><a class="text-link" href={`/airport/${a.slug}/`}>查看资料 <span>↗</span></a></article>
