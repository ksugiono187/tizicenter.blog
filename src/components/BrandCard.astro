---
import {price,traffic,unknown} from '../data/airports';
import Coupon from './Coupon.astro';
const {airport:a}=Astro.props;
---
<article class="brand-card"><div class="brand-top"><span class="brand-icon">{a.name.slice(0,1)}</span><span class="badge">运营者提供 · 待核实</span></div><h3><a href={`/airport/${a.slug}/`}>{a.name}</a></h3><p>{a.description}</p><Coupon airport={a}/><dl class="metrics"><div><dt>起步价格</dt><dd>{price(a)}</dd></div><div><dt>套餐流量</dt><dd>{traffic(a)}</dd></div><div><dt>线路类型</dt><dd>{a.lineType??unknown}</dd></div></dl><a class="button brand-visit" href={a.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">访问推广入口 ↗</a><p class="small muted">推广链接：通过此入口注册或购买，本站可能获得佣金。</p><a class="text-link" href={`/airport/${a.slug}/`}>查看品牌与优惠说明 <span>↗</span></a></article>
