---
import type {Airport} from '../data/airports';
import BrandMark from './BrandMark.astro';
import Coupon from './Coupon.astro';
import Icon from './Icon.astro';
import {brandPublicChecks} from '../data/brand-public-checks';
import PublicBrandReferences from './PublicBrandReferences.astro';
import BrandResearchStatus from './BrandResearchStatus.astro';
import {brandReferences} from '../data/brand-references';
import {getBrandInformation} from '../data/brand-information';
const {airport:a,review=false}=Astro.props as {airport:Airport;review?:boolean};
const information=getBrandInformation(a.slug);
const reference=brandReferences.find(r=>r.slug===a.slug);
const publicCheck=brandPublicChecks.find(check=>check.slug===a.slug);
---
<div class="brand-detail-grid">
 <div>
  <section class="detail-offer"><div class="detail-identity"><BrandMark airport={a} large={true}/><div><span class="eyebrow">BRAND INFORMATION</span><h2>{a.name}</h2><span class="badge">{information.summary}</span></div></div><h3>{a.couponCode?'已提供的优惠码':'品牌访问入口'}</h3><Coupon airport={a}/><p class="offer-help">{a.couponCode?'复制代码后，在结算页核对实际抵扣金额与适用套餐。优惠幅度及有效期尚未核实。':'优惠码：未提供。购买前请在服务页面核对价格、账单周期和优惠条件。'}</p><div class="actions"><a class="button" href={a.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">访问推广入口 <Icon name="external" size={17}/></a><a class="button secondary" href={`/compare/?brands=${a.slug}`}><Icon name="compare" size={17}/>加入比较</a></div><div class="disclosure compact"><Icon name="shield" size={17}/><p>此入口为推广链接，通过其注册或购买，本站可能获得佣金。</p></div></section>
  <BrandResearchStatus slug={a.slug}/>
  <PublicBrandReferences slug={a.slug}/>
  <section class="detail-section prose"><h2>{review?'付款前，完成这份检查':'先确认条件，再做决定'}</h2><p>品牌入口与优惠码由运营者提供；如有网上参考报价，本页另列出处与分歧。当前商城、经营方身份和实际连接表现尚未独立核验，以下清单帮助你在付款前补齐信息。</p><ol class="purchase-steps"><li><strong>确认页面与经营方</strong><span>核对访问地址、服务条款和支持渠道。推广入口不等于已验证的官网身份。</span></li><li><strong>看完整账单</strong><span>确认币种、一次支付金额、周期、续费与退款窗口，区分月付和年付月均价。</span></li><li><strong>检查优惠是否生效</strong><span>保留代码大小写，核对实际优惠和适用套餐，再确认付款。</span></li><li><strong>验证自己的使用任务</strong><span>确认设备、流量和客户端条件。有试用时先检查连接与实际任务表现。</span></li></ol><div class="inline-links"><a href="/blog/purchase-checklist/">完整购买清单 <Icon name="arrow" size={16}/></a><a href="/guides/first-connection/">首次连接检查 <Icon name="arrow" size={16}/></a></div></section>
  <section class="detail-section"><h2>待补充的品牌资料</h2><p class="muted">缺失信息保持明确标注，补齐来源后再更新。</p>{publicCheck&&<div class="public-check"><span class="eyebrow">公开资料检查 · {publicCheck.checkedAt}</span><p>{publicCheck.note}</p><small>检查范围为所提供推广域名的公开入口；未读取完整资料不代表服务不可用，入口可读也不代表经营方身份已确认。</small></div>}<div class="verification-list">{[['套餐与计费','已有第三方参考价目；当前商城价格、流量、计费周期、重置规则和倍率仍未独立核实。'],['线路与设备','地区、线路类型、协议、设备限制和客户端兼容性均尚未核实。'],['实际使用表现','连接速度、稳定性、AI 与流媒体可用性均尚未实测。']].map(([title,body])=><details><summary><span>{title}</span><span class="badge">尚未核实</span></summary><p>{body}</p></details>)}</div></section>
  <section class="detail-section"><h2>常见问题</h2><div class="faq"><details><summary>优惠码是否保证有效？</summary><p>不保证。代码由运营者提供，优惠幅度、期限及适用范围尚未核实，以服务商结算页面为准。</p></details><details><summary>这是一份实测评测吗？</summary><p>本页整理品牌入口、优惠码与购买检查事项，没有独立性能样本，不评价服务质量或适合人群。</p></details></div></section>
 </div>
 <aside class="detail-sidebar"><div class="side-panel"><span class="eyebrow">INFORMATION RECORD</span><h3>资料记录</h3><dl><div><dt>信息状态</dt><dd>{information.summary}</dd></div><div><dt>资料来源</dt><dd>运营者入口 / 第三方公开参考</dd></div><div><dt>入口整理日期</dt><dd>{a.submittedAt}</dd></div><div><dt>公开资料查阅</dt><dd>{reference?.reviewedAt??'暂无记录'}</dd></div><div><dt>套餐与服务核验</dt><dd>尚未核实</dd></div><div><dt>优惠码</dt><dd>{a.couponCode?'已提供 · 有效性待核实':'未提供'}</dd></div></dl><a class="text-link" href="#research-status">查看逐项核对清单 ↘</a><a class="text-link" href={`/contact/?brand=${a.slug}`}>提交资料纠错 <Icon name="arrow" size={16}/></a></div><div class="side-panel"><h3>继续浏览</h3><a href="/airport/"><Icon name="grid" size={18}/>全部品牌目录</a><a href={review?`/airport/${a.slug}/`:`/review/${a.slug}/`}><Icon name="book" size={18}/>{review?'品牌入口与优惠码':'购买前检查'}</a><a href="/editorial-policy/"><Icon name="shield" size={18}/>编辑政策与推广披露</a></div></aside>
</div>
