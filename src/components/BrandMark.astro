---
import type {Airport} from '../data/airports';
const {airport:a,large=false}=Astro.props as {airport:Airport;large?:boolean};
const tone=[...a.slug].reduce((sum,c)=>sum+c.charCodeAt(0),0)%6;
---
<span class:list={['brand-icon',`tone-${tone}`,{'brand-icon-large':large}]} aria-hidden="true">{a.name.slice(0,1)}</span>
