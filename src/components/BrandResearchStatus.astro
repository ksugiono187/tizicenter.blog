---
import {brandReferences} from '../data/brand-references';
import {getBrandInformation} from '../data/brand-information';
const {slug}=Astro.props;
const reference=brandReferences.find(r=>r.slug===slug);
const information=getBrandInformation(slug);
---
<section class="detail-section research-status" id="research-status" aria-labelledby="research-status-title">
 <span class="eyebrow">INFORMATION STATUS / 信息状态</span><h2 id="research-status-title">{information.name} · 资料核对清单</h2>
 <p class="information-summary"><strong>{information.summary}</strong><span>最近查阅 <time datetime={information.reviewedAt}>{information.reviewedAt??'暂无记录'}</time></span></p>
 <p class="small muted">“已整理”表示已收录并标明来源，“已提供”表示运营者提交；两者都不代表套餐、优惠或服务已经官方确认。查阅日期也不是报价生效日期。</p>
 <dl class="information-fields">{information.fields.map(field=><div data-information-field={field.key}><dt>{field.label}<span class:list={['information-badge',field.tone]}>{field.state}</span></dt><dd>{field.detail}</dd></div>)}</dl>
 {reference&&<p class="research-revision"><strong>本轮整理：</strong>{reference.revisionNote}</p>}
 <div class="inline-links"><a href="#public-references">查看逐条来源与报价 ↘</a><a href="/brand-updates/">查看全部 29 家信息状态 ↗</a><a href={"/contact/?brand="+slug}>提交此品牌纠错 ↗</a></div>
</section>
