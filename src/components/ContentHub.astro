---
import ArticleCards from './ArticleCards.astro';
import BlogIndex from './BlogIndex.astro';
const {items,category}=Astro.props;
const guide=category==='guides';
const groups=guide?[
{id:'devices',name:'01 / 按设备安装',description:'选自己的设备，完成下载、权限确认与网络恢复。',ids:['windows','macos','android','ios']},
{id:'setup',name:'02 / 配置与首次连接',description:'先导入正确格式，再用真实任务验证连接。',ids:['subscription-import','clash-verge-rev','first-connection']},
{id:'troubleshooting',name:'03 / 遇到问题',description:'按错误阶段排查，保留可用配置和脱敏记录。',ids:['subscription-errors','connection-troubleshooting']}
]:[
{id:'buying',name:'选购与预算',description:'理解交付方式，按实际需求和完整账单选择。',ids:['airport-vs-vpn','choose-service','purchase-checklist','plan-cost','traffic-budget','coupon-use','renewal-check','free-vpn']},
{id:'tasks',name:'日常任务与体验',description:'分别验证实际业务，记录稳定性并准备有效反馈。',ids:['ai-access','streaming-check','stability-method','support-ticket']},
{id:'privacy',name:'隐私与凭据',description:'读懂隐私声明，保护订阅地址和账户信息。',ids:['privacy-claims','subscription-security']}
];
const path=[['first-connection','先看完成标准','知道什么才算连接成功'],['subscription-import','导入订阅','区分订阅地址与推广入口'],['connection-troubleshooting','学会排查','有问题时按步骤定位']];
---
{!guide?<BlogIndex items={items}/>:<div class="content-hub">
 <div class="hub-overview"><div><span class="eyebrow">{guide?'START HERE / 新手路线':'READ WITH PURPOSE / 阅读专题'}</span><h2>{guide?'从第一次安装，到独立排查。':'围绕你的问题，找到下一篇。'}</h2><p>{guide?'9 篇教程均提供操作顺序、完成标志和个人检查表。先按设备安装，再配置与验收，遇到错误按现象定位。':'选套餐前读预算，付款前查优惠，使用中留下真实记录。'}</p></div><span class="hub-total">{items.length}<small>{guide?'篇使用教程':'篇博客文章'}</small></span></div>
 {guide&&<div class="learning-path">{path.map(([id,title,desc],i)=><a href={`/guides/${id}/`}><span class="path-number">0{i+1}</span><div><strong>{title}</strong><p>{desc}</p></div><span aria-hidden="true">↗</span></a>)}</div>}
 <nav class="hub-jumps" aria-label="文章分类">{groups.map(g=><a href={`#${g.id}`}>{g.name.replace(/^\d+ \/ /,'')}<span>{g.ids.filter(id=>items.some((a:any)=>a.id===id)).length}</span></a>)}<a href="/search/">搜索文章 ↗</a></nav>
 {groups.map(g=><section class="hub-group" id={g.id}><div class="section-head"><div><h2>{g.name}</h2><p>{g.description}</p></div></div><ArticleCards items={g.ids.map(id=>items.find((a:any)=>a.id===id)).filter(Boolean)}/></section>)}
 <div class="notice">{guide?'教程采用通用流程，具体按钮、格式与权限以当前客户端及服务方文档为准。品牌兼容性尚未逐一核实。':'金额举例为计算示例；品牌价格、优惠条件和实际性能尚未核实。阅读方法文章后，请在服务方结算页核对自己的订单。'}</div>
</div>}
