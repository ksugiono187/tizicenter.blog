---
import type {Airport} from '../data/airports';
const {airport:a,compact=false}=Astro.props as {airport:Airport;compact?:boolean};
---
<div class:list={['coupon',{'coupon-compact':compact}]}>
{a.couponCode?<><span class="coupon-label">优惠码</span><code>{a.couponCode}</code><button type="button" class="coupon-copy" data-coupon={a.couponCode} aria-label={`复制 ${a.name} 优惠码`}>复制</button><span class="coupon-status" role="status" aria-live="polite"></span>{!compact&&<small>运营者提供 · 优惠幅度、有效期与适用套餐尚未核实</small>}</>:<span class="small muted">优惠码：未提供</span>}
</div>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-coupon]').forEach(button=>button.addEventListener('click',async()=>{
 const status=button.parentElement!.querySelector<HTMLElement>('.coupon-status')!;
 try {await navigator.clipboard.writeText(button.dataset.coupon!);status.textContent='已复制';}
 catch {status.textContent='复制失败，请手动复制上方代码';}
}));
</script>
