---
import {brandReferences} from '../data/brand-references';
const {slug}=Astro.props;
const reference=brandReferences.find(r=>r.slug===slug);
---
{reference&&<section class="detail-section public-references" id="public-references"><span class="eyebrow">PUBLIC REFERENCES / 网上公开资料</span><h2>公开报价与来源记录</h2><p class="muted">按品牌名称检索并阅读于 2026-10-13。以下是各来源页面的描述，当前商城在售状态及经营主体对应关系尚未核实。</p><div class="reference-boundary">报价属于第三方参考资料，不参与本站价格排名、每 GB 计算或已核实套餐比较。来源标注日期与本站阅读日期分别记录。</div>
 {reference.sources.map(source=>{const offers=reference.offers.filter(o=>o.sourceId===source.id);return <div class="reference-source"><h3><a href={source.url} target="_blank" rel="nofollow noopener noreferrer">{source.publisher} ↗</a></h3><p class="small muted">来源标注日期：{source.reportedDate??'未找到明确日期'} · 本站阅读：{source.readAt}</p>{offers.length>0?<div class="table-wrap" tabindex="0" role="region" aria-label={`${source.publisher}报价记录，可横向滚动`}><table><caption>{source.publisher}公开报价记录 · 未核实当前在售</caption><thead><tr><th scope="col">来源套餐名</th><th scope="col">人民币金额</th><th scope="col">支付周期</th><th scope="col">来源额度描述</th></tr></thead><tbody>{offers.map(o=><tr><td>{o.name}</td><td>¥{o.amount}</td><td>{o.periodLabel}</td><td>{o.trafficLabel}</td></tr>)}</tbody></table></div>:<p class="small">此来源用于核对资料差异，不据此补写价目。</p>}</div>;})}
 <div class="reference-differences"><h3>资料差异与仍需确认的条件</h3><ul>{reference.differences.map(text=><li>{text}</li>)}</ul><dl><div><dt>退款条款</dt><dd>{reference.refund}</dd></div><div><dt>优惠说明</dt><dd>{reference.coupon}</dd></div></dl></div>
 <a class="text-link" href="/blog/purchase-checklist/">付款前怎样核对当前条件 ↗</a>
</section>}
