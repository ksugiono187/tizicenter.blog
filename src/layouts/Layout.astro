---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
const {title,description,noindex=false,article=false,published,updated,schema=[],crumbs=[]}=Astro.props;
const origin='https://tizicenter.blog';
const canonical=new URL(Astro.url.pathname,origin).href;
const nav=[['/','首页'],['/airport/','品牌目录'],['/recommend/','机场推荐'],['/compare/','横向比较'],['/guides/','使用教程'],['/blog/','知识文章'],['/tools/','预算工具']];
const active=(href:string)=>href==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(href);
const common=[{'@context':'https://schema.org','@type':'Organization',name:'梯子中心',url:origin},{'@context':'https://schema.org','@type':'WebSite',name:'梯子中心',url:origin,inLanguage:'zh-CN'},...(crumbs.length?[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'首页',url:'/'},...crumbs].map((c:any,i:number)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.url,origin).href}))}]:[]),...schema];
---
<!doctype html><html lang="zh-CN"><head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#1456d8"/>
 <title>{title} · 梯子中心</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/>
 <meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="梯子中心"/><meta property="og:locale" content="zh_CN"/><meta property="og:image" content={`${origin}/social.svg`}/>
 <meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>{article&&<><meta property="article:published_time" content={published}/><meta property="article:modified_time" content={updated}/></>}
 <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{common.map(s=><script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g,'\\u003c')}/> )}
</head><body>
 <a class="skip" href="#main">跳至正文</a>
 <header class="site-header"><div class="container header">
  <a class="logo" href="/" aria-label="梯子中心首页"><span class="logo-mark">T<span></span></span><span class="logo-type">梯子中心<small>TIZI CENTER</small></span></a>
  <nav aria-label="主导航" class="desktop-nav">{nav.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}</nav>
  <div class="header-actions"><a class="search-link" href="/search/" aria-label="搜索文章"><Icon name="search" size={20}/></a><a class="header-coupon" href="/#coupons"><Icon name="gift" size={17}/>优惠码</a><details class="mobile-nav"><summary aria-label="打开导航菜单"><Icon name="menu" size={21}/><span>菜单</span></summary><nav aria-label="手机导航">{nav.map(([href,label])=><a href={href} aria-current={active(href)?'page':undefined}>{label}</a>)}<a href="/#coupons">优惠码中心</a></nav></details></div>
 </div></header>
 <main id="main">{crumbs.length>0&&<nav aria-label="面包屑导航" class="container breadcrumbs"><a href="/">首页</a>{crumbs.map((c:any)=><><Icon name="chevron" size={12}/><a href={c.url}>{c.name}</a></>)}</nav>}<slot/></main>
 <footer class="site-footer"><div class="container footer-grid">
  <div class="footer-brand"><a class="logo" href="/"><span class="logo-mark">T<span></span></span><span class="logo-type">梯子中心<small>TIZI CENTER</small></span></a><p>品牌、优惠、教程，一站查找。<br/>为每一次选择，补齐信息。</p><span class="footer-label">中文机场与 VPN 知识指南</span></div>
  <div><strong>发现与比较</strong><a href="/airport/">品牌目录</a><a href="/#coupons">优惠码中心</a><a href="/recommend/">按需求选择</a><a href="/compare/">横向比较</a><a href="/ranking/">排行榜标准</a><a href="/review/">购买检查</a><a href="/brand-updates/">品牌资料进度</a></div>
  <div><strong>学习与使用</strong><a href="/reading/">15 篇阅读路线</a><a href="/guides/">教程中心</a><a href="/blog/">知识文章</a><a href="/glossary/">术语百科</a><a href="/tools/">费用与流量计算器</a><a href="/blog/purchase-checklist/">购买前检查</a><a href="/guides/first-connection/">首次连接指南</a></div>
  <div><strong>关于梯子中心</strong>{[['about','关于我们'],['editorial-policy','编辑政策'],['contact','联系与纠错'],['privacy-policy','隐私政策'],['disclaimer','免责声明']].map(([s,n])=><a href={`/${s}/`}>{n}</a>)}</div>
 </div><div class="container footer-disclosure"><Icon name="shield" size={17}/><p>本站包含推广链接，通过其注册或购买可能产生佣金。品牌入口及优惠码由运营者提供，套餐、优惠有效性与性能尚未核实。</p></div><div class="container footer-bottom"><span>© 2026 梯子中心 · tizicenter.blog</span><a href="/sitemap-index.xml">网站地图 <Icon name="external" size={12}/></a></div></footer>
</body></html>
