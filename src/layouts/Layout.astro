---
import '../styles/global.css';
const {title,description,noindex=false,article=false,published,updated,schema=[],crumbs=[]}=Astro.props;
const origin='https://tizicenter.blog';
const canonical=new URL(Astro.url.pathname,origin).href;
const nav=[['/','首页'],['/recommend/','机场推荐'],['/ranking/','机场排行'],['/review/','资料评析'],['/compare/','机场对比'],['/guides/','使用教程'],['/blog/','博客文章']];
const common=[{'@context':'https://schema.org','@type':'Organization',name:'梯子中心',url:origin},{'@context':'https://schema.org','@type':'WebSite',name:'梯子中心',url:origin,inLanguage:'zh-CN'},...(crumbs.length?[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'首页',url:'/'},...crumbs].map((c:any,i:number)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.url,origin).href}))}]:[]),...schema];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · 梯子中心</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="梯子中心"/><meta property="og:locale" content="zh_CN"/><meta property="og:image" content={`${origin}/social.svg`}/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>{article&&<><meta property="article:published_time" content={published}/><meta property="article:modified_time" content={updated}/></>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{common.map(s=><script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g,'\\u003c')}/> )}</head><body><a class="skip" href="#main">跳至正文</a><header><div class="container header"><a class="logo" href="/"><span class="logo-mark">T</span>梯子中心<small>TIZI CENTER</small></a><nav aria-label="主导航" class="desktop-nav">{nav.map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav><a class="search-link" href="/search/" aria-label="搜索文章">⌕</a><details class="mobile-nav"><summary>菜单</summary><nav aria-label="手机导航">{nav.map(([href,label])=><a href={href}>{label}</a>)}</nav></details></div></header><main id="main">{crumbs.length>0&&<div class="container breadcrumbs"><a href="/">首页</a>{crumbs.map((c:any)=><><span>/</span><a href={c.url}>{c.name}</a></>)}</div>}<slot/></main><footer><div class="container footer-grid"><div><a class="logo" href="/">梯子中心</a><p>把复杂的选择，变成有依据的决定。</p><p class="muted">独立整理 · 来源可查 · 未实测不下结论</p></div><div><strong>探索</strong><a href="/recommend/">选择指南</a><a href="/airport/">品牌资料库</a><a href="/compare/">横向比较</a><a href="/guides/">教程中心</a></div><div><strong>关于网站</strong>{[['about','关于我们'],['contact','联系与纠错'],['editorial-policy','编辑政策'],['privacy-policy','隐私政策'],['disclaimer','免责声明']].map(([s,n])=><a href={`/${s}/`}>{n}</a>)}</div></div><div class="container footer-bottom"><span>© 2026 梯子中心 · tizicenter.blog</span><a href="/sitemap-index.xml">Sitemap ↗</a></div></footer></body></html>
