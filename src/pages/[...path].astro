---
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import ArticleCards from '../components/ArticleCards.astro';
import {airports,price,traffic,unknown,evidence,budgetRank,valueRank} from '../data/airports';
import {topics} from '../data/topics';
import {siteUpdated} from '../data/site';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){
const articles=await getCollection('articles',a=>!a.data.draft);
const hubs=[['recommend','按需求选择机场与 VPN'],['ranking','透明排行榜与评价方法'],['airport','真实 VPN 品牌资料库'],['review','独立资料评析中心'],['guides','设备使用教程中心'],['blog','机场选择与 VPN 知识文章'],['glossary','网络与订阅术语百科']];
return [...hubs.map(([path,title])=>({params:{path},props:{type:'hub',title,category:path}})),...topics.map(t=>({params:{path:`recommend/${t.slug}`},props:{type:'topic',title:`${t.name}方案怎么选`,topic:t}})),...['overall','value','budget','stable'].map(s=>({params:{path:`ranking/${s}`},props:{type:'ranking',slug:s,title:({overall:'综合资料完整度榜',value:'有限流量套餐每 GB 成本榜',budget:'已核验零预算方案榜',stable:'稳定性排行榜：测试标准与待测清单'} as any)[s]}})),...airports.flatMap(a=>['airport','review'].map(type=>({params:{path:`${type}/${a.slug}`},props:{type,airport:a,title:type==='airport'?`${a.name} 官方资料与套餐说明`:`${a.name} 资料评析：优势、限制与购买检查`}}))),...articles.map(entry=>({params:{path:`${entry.data.category}/${entry.id}`},props:{type:'article',title:entry.data.title,entry}}))];
}
const {type,title,category,topic,slug,airport:a,entry}=Astro.props as any;
const posts=(await getCollection('articles',a=>!a.data.draft)).sort((a,b)=>b.data.updated.getTime()-a.data.updated.getTime());
const rendered=entry?await render(entry):null;const Content=rendered?.Content;
const current=Astro.url.pathname;
const parents:any={recommend:'需求选择',ranking:'排行榜',airport:'品牌资料',review:'资料评析',guides:'使用教程',blog:'博客文章',glossary:'知识百科'};
const group=current.split('/')[1];
const description=entry?.data.description??topic?.answer??(a?(type==='review'?`${a.name} 独立资料评析：根据官方公开条件分析优势、限制、适合人群与购买检查。没有速度、稳定性或解锁实测。`:`${a.name} 官方资料页：查看公开套餐、账单周期、设备限制、数据来源和核验日期，缺失字段标注尚未核实。`):`${title}：公开资料来源、比较方法、适合人群与未核实事项，帮助读者作出有依据的选择。`);
const noindex=(type==='ranking'&&slug==='stable')||(type==='topic'&&topic.slug==='premium');
const crumbs=current===`/${group}/`?[{name:parents[group],url:current}]:[{name:parents[group],url:`/${group}/`},{name:title,url:current}];
const related=entry?posts.filter(p=>p.id!==entry.id&&p.data.tags.some(t=>entry.data.tags.includes(t))).slice(0,3):posts.filter(p=>p.data.category==='blog').slice(0,3);
let schema:any[]=[];
if(type==='review') schema=[{'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:siteUpdated,dateModified:a.lastVerified||siteUpdated,author:{'@type':'Organization',name:'梯子中心'},mainEntityOfPage:`https://tizicenter.blog${current}`,citation:a.sources}];
if(entry) schema=[{'@context':'https://schema.org','@type':'BlogPosting',headline:title,description,datePublished:entry.data.published.toISOString(),dateModified:entry.data.updated.toISOString(),author:{'@type':'Organization',name:'梯子中心'},mainEntityOfPage:`https://tizicenter.blog${current}`}];
if(type==='ranking'&&slug!=='stable'){const list=slug==='overall'?[...airports].sort((a,b)=>evidence(b)-evidence(a)):slug==='budget'?budgetRank():valueRank().map(v=>v.airport);schema=[{'@context':'https://schema.org','@type':'ItemList',name:title,itemListElement:list.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:`https://tizicenter.blog/airport/${a.slug}/`}))}];}
---
<Layout title={title} description={description} noindex={noindex} crumbs={crumbs} schema={schema} article={!!entry} published={entry?.data.published.toISOString()} updated={entry?.data.updated.toISOString()}><div class="container"><div class="page-intro"><span class="eyebrow">{type==='article'?'TIZI CENTER / KNOWLEDGE':'TIZI CENTER / EDITORIAL'}</span><h1>{title}</h1><p>{description}</p>{type!=='hub'&&<p class="small">{entry?'发布 / 更新':'资料整理 / 核验'}：{entry?entry.data.updated.toISOString().slice(0,10):a?.lastVerified||siteUpdated} · <a href="/editorial-policy/">查看编辑标准</a></p>}</div>
{type==='article'&&<><div class="article-layout"><article class="prose">{Content&&<Content/>}<h2>资料来源</h2><div class="sources">{entry.data.sources.map((s:string)=><a href={s} target="_blank" rel="noopener noreferrer">{s} ↗</a>)}</div></article><aside class="sidebar"><strong>本文目录</strong>{rendered?.headings.filter((h:any)=>h.depth===2).map((h:any)=><a href={`#${h.slug}`}>{h.text}</a>)}<strong>相关入口</strong><a href="/recommend/">按需求选择</a><a href="/compare/">横向比较工具</a><a href="/glossary/">基础术语</a></aside></div><section class="section"><h2>继续阅读</h2><ArticleCards items={related}/></section></>}
{type==='hub'&&<section class="section">{category==='recommend'?<div class="topic-grid">{topics.map(t=><a class="topic" href={`/recommend/${t.slug}/`}><span class="topic-icon">{t.symbol}</span><div><strong>{t.name}</strong><small>{t.summary}</small></div></a>)}</div>:category==='ranking'?<><div class="notice">排名依据公开。当前没有速度与稳定性实测，资料完整度不能解释为服务质量评分。</div><div class="article-grid">{[['overall','综合资料完整度','五项资料字段的公开覆盖情况'],['budget','低预算方案','已核验零费用月度方案，并列呈现'],['value','每 GB 成本','只计算周期与流量都明确的有限套餐'],['stable','稳定性测试标准','待实测，不发布名次']].map(([s,n,d])=><a class="article-card" href={`/ranking/${s}/`}><h2>{n}</h2><p>{d}</p><span class="text-link">查看依据 ↗</span></a>)}</div></>:category==='airport'?<><div class="notice">这里收录 5 家 VPN 品牌，不将其冒充机场。尚无已核验机场订阅资料。</div><div class="brand-grid">{airports.map(a=><BrandCard airport={a}/>)}</div></>:category==='review'?<><div class="notice">以下为独立资料评析。尚未进行速度、稳定性、AI 或流媒体测试。</div><div class="article-grid">{airports.map(a=><a class="article-card" href={`/review/${a.slug}/`}><span class="eyebrow">官方资料 · 未实测</span><h2>{a.name}</h2><p>{a.description}</p><span class="text-link">阅读资料评析 ↗</span></a>)}</div></>:<ArticleCards items={posts.filter(a=>a.data.category===category)}/>}</section>}
{type==='topic'&&<><div class="article-layout"><article class="prose"><h2>先给结论</h2><p>{topic.answer}</p><h2>选择时逐项检查</h2><ul>{topic.checks.map((c:string)=><li>{c}</li>)}</ul><h2>怎样进行小范围验证</h2><p>把真实使用任务列成清单：使用的设备、每天可接受的费用、需要的流量和目标服务。在付款前保存条款与官方资料的核验日期。先测试连接和账户访问，再观察正常工作时段与高峰时段的表现。记录问题发生条件，避免把本地网络故障误认为品牌质量差异。</p><h2>常见问题</h2><h3>这个专题保证品牌可用吗？</h3><p>不保证。官方资料只证明公开方案与说明存在，无法替代你所在网络的实际测试。本网站当前没有品牌级连接样本。</p><h3>有长期优惠时应该立即购买吗？</h3><p>先核对一次性支付总额、续费价和退款窗口，并评估条款变化风险。短期验证通常比单看月均折扣更能减少不确定性。</p><h2>下一步</h2><p><a href="/ranking/budget/">查看已核验低预算方案</a>，再用 <a href="/compare/">比较工具</a> 核对资料差异。若使用机场订阅，先读 <a href="/blog/airport-vs-vpn/">机场与 VPN 的区别</a>。</p></article><aside class="sidebar"><strong>相关专题</strong>{topics.filter(t=>t.slug!==topic.slug).slice(0,3).map(t=><a href={`/recommend/${t.slug}/`}>{t.name}</a>)}<strong>比较方法</strong><a href="/ranking/overall/">资料完整度标准</a><a href="/blog/plan-cost/">套餐成本计算</a></aside></div><section class="section"><h2>有出处的参考资料</h2>{topic.brands.length?<div class="brand-grid">{airports.filter(a=>topic.brands.includes(a.id)).map(a=><BrandCard airport={a}/>)}</div>:<div class="empty">尚无符合本专题要求的品牌级核验数据。当前不发布推荐名次。</div>}</section></>}
{(type==='airport'||type==='review')&&<><div class="notice">VPN 品牌 · 官方公开资料 · 未实测。套餐并不保证特定地区连接、AI 或流媒体可用。</div><div class="article-layout"><article class="prose"><h2>一句话结论</h2><p>{a.description} {type==='review'?'我们的判断是：先确认这些套餐条件适合你的使用方式，再以短期体验验证；公开资料无法证明性能。':''}</p><h2>品牌基本介绍</h2><p>{a.name} 提供 VPN 服务，详情以 <a href={a.officialUrl} target="_blank" rel="noopener noreferrer">品牌官网</a> 为准。本站未与该品牌建立联盟推广关系；当前没有购买返佣链接。</p><h2>套餐价格与流量</h2><div class="table-wrap"><table><thead><tr><th>方案</th><th>账单金额</th><th>周期</th><th>流量</th><th>核验条件</th></tr></thead><tbody>{a.plans.map((p:any)=><tr><td>{p.name}</td><td>{p.currency} {p.price}</td><td>{{month:'月',year:'年',week:'周',lifetime:'不限时'}[p.period as 'month']}</td><td>{p.unlimited?'不限流量':p.trafficGB?`${p.trafficGB} GB`:unknown}</td><td>{p.condition||'官网公开方案'}</td></tr>)}</tbody></table></div><p>年付金额是一次性支付总额，不能等同月付；未注明流量的方案不参与每 GB 成本计算。优惠或税费发生变化时请核对付款页面。</p><h2>节点与线路资料</h2><p>地区：{a.regions.join('、')||unknown}。线路类型：{a.lineType||unknown}。本网站未验证线路拓扑、带宽和高峰表现。</p><h2>客户端与设备支持</h2><p>设备限制：{a.deviceLimit||unknown}。协议：{a.protocols.join('、')||unknown}。下载软件时从官方入口选择系统版本，具体兼容要求以最新下载页为准。</p><h2>AI 与流媒体支持</h2><p>AI：{a.aiSupport?.join('、')||unknown}。流媒体：{a.streamingSupport?.join('、')||unknown}。网页能够打开不等于账户可用或内容播放成功，官方宣传也不属于本站实测。</p><h2>优势与限制分析</h2><h3>已公开的优势</h3><ul>{a.advantages.map((s:string)=><li>{s}</li>)}</ul><h3>购买前应留意</h3><ul>{a.disadvantages.map((s:string)=><li>{s}</li>)}</ul><h2>适合人群</h2><p>{a.suitableFor.join('、')}。这是基于套餐条件的编辑判断，未评价特定网络的连接质量。</p><h2>购买前检查</h2><p>核对官方域名、付款总額、套餐周期、退款条件、设备数和所需功能。保存购买时的条款，不向任何第三方提供账户或订阅凭据。先完成 <a href="/guides/first-connection/">首次连接检查</a>。</p><h2>常见问题</h2><h3>这里的数据经过实际测速吗？</h3><p>没有。只核验官方页面公开的方案资料，未进行连接、速度、稳定性或解锁测试。</p><h3>这家品牌可以替代机场订阅吗？</h3><p>使用方式不同。先确认你需要官方 VPN 客户端还是兼容代理订阅的工具，参考 <a href="/blog/airport-vs-vpn/">区别指南</a>。</p><h2>相关比较</h2><p>将 {a.name} 与其他品牌放入 <a href="/compare/">横向比较工具</a>，或者查看 <a href="/ranking/overall/">资料完整度榜</a>。资料页和评析使用同一数据库，价格不重复维护。</p><h2>来源与核验日期</h2><p>官方资料最后核验：{a.lastVerified}。分析为本站编辑整理，实际测试：未进行。缺失字段：尚未核实。</p><div class="sources">{a.sources.map((s:string)=><a href={s} target="_blank" rel="noopener noreferrer">{s} ↗</a>)}</div></article><aside class="sidebar"><strong>阅读路线</strong><a href={type==='review'?`/airport/${a.slug}/`:`/review/${a.slug}/`}>{type==='review'?'品牌资料页':'独立资料评析'}</a><a href="/compare/">对比其他品牌</a><a href="/recommend/beginner/">新手专题</a><a href="/editorial-policy/">编辑与合作披露</a></aside></div></>}
{type==='ranking'&&<><div class="notice">更新时间：2026-10-13。官方资料核验不等于服务实测；当前没有机场订阅或性能评分。</div><section class="prose"><h2>快速结论</h2><p>{slug==='overall'?'资料越完整，越容易作出有依据的判断。本榜只比较五项信息是否具有可核验依据，不衡量速度、隐私或可用性。':slug==='budget'?'当前核验到 Proton VPN 和 Windscribe 的零费用月度方案，两者并列；流量条件不同，不作“最好”结论。':slug==='value'?'仅 Windscribe 的有限月度流量与价格条件满足当前计算要求，成本为 USD 0 / GB，需验证邮箱。只有一个有效候选，不能推导行业性价比冠军。':'尚无持续测试样本，不发布稳定性排名。下方列出测试方法和待测对象。'}</p><h2>排名依据</h2><p>{slug==='overall'?'每项 1 分：官网入口、已核验套餐、设备限制、协议资料、带日期的来源记录，共 5 项；同分并列。此分数不等于可信度或安全性评分。':slug==='budget'?'只收录已核验、月度周期明确且价格为 0 的方案，按同一费用并列。付费方案保留原币种，不能未经汇率核验进行统一价格排序。':slug==='value'?'每 GB 单价 = 套餐价格 /（标称流量 ÷ 倍率）。仅已核验的有限月付套餐参与；年付、周付、不限时、不限流量和未核实周期全部排除。不同币种分组比较。':'正式测试需记录设备、客户端版本、网络、地区、时段、节点、次数、连接成功率、延迟、丢包、断线与恢复时间。先固定条件，再重复采样；发布原始记录后才允许排序。'}</p></section><div class="table-wrap"><table><thead><tr><th>{slug==='overall'?'资料项数':slug==='stable'?'测试状态':'名次'}</th><th>品牌</th><th>方案 / 起步价格</th><th>流量</th><th>依据</th><th>评析</th></tr></thead><tbody>{(slug==='budget'?budgetRank():slug==='value'?valueRank().map(v=>v.airport):slug==='overall'?[...airports].sort((a,b)=>evidence(b)-evidence(a)):airports).map(a=><tr><td>{slug==='overall'?`${evidence(a)} / 5（同分并列）`:slug==='stable'?'未测试':slug==='budget'?'并列 1':'1（单候选）'}</td><td>{a.name}</td><td>{price(a)}</td><td>{traffic(a)}</td><td>{slug==='value'?'USD 0 / GB，验证邮箱':slug==='stable'?'暂无实测记录':'官方公开资料'}</td><td><a href={`/review/${a.slug}/`}>阅读评析 ↗</a></td></tr>)}</tbody></table></div><section class="section"><h2>品牌简介与适合人群</h2><div class="brand-grid">{(slug==='budget'?budgetRank():slug==='value'?valueRank().map(v=>v.airport):airports).map(a=><BrandCard airport={a}/>)}</div></section><section class="prose"><h2>数据来源</h2><p>所有条目来自品牌数据库，每个资料页列出具体官方来源及核验条件。稳定性、AI 与流媒体字段保持“尚未核实”。</p><p><a href="/airport/">查看品牌来源库</a> · <a href="/compare/">进入比较工具</a> · <a href="/editorial-policy/">编辑标准与更新规则</a></p></section></>}
</div></Layout>
