---
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import Coupon from '../components/Coupon.astro';
import ArticleCards from '../components/ArticleCards.astro';
import {airports,price,traffic,unknown} from '../data/airports';
import {topics} from '../data/topics';
import {siteUpdated} from '../data/site';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){
const articles=await getCollection('articles',a=>!a.data.draft);
const hubs=[['recommend','按需求选择机场与 VPN'],['ranking','透明排行榜与评价方法'],['airport','机场品牌与优惠码资料库'],['review','品牌购买检查中心'],['guides','设备使用教程中心'],['blog','机场选择与 VPN 知识文章'],['glossary','网络与订阅术语百科']];
return [...hubs.map(([path,title])=>({params:{path},props:{type:'hub',title,category:path}})),...topics.map(t=>({params:{path:`recommend/${t.slug}`},props:{type:'topic',title:`${t.name}方案怎么选`,topic:t}})),...['overall','value','budget','stable'].map(s=>({params:{path:`ranking/${s}`},props:{type:'ranking',slug:s,title:({overall:'综合排行榜：资料核验标准',value:'性价比榜：套餐成本核验标准',budget:'低预算榜：价格核验标准',stable:'稳定性排行榜：测试标准与待测清单'} as any)[s]}})),...airports.flatMap(a=>['airport','review'].map(type=>({params:{path:`${type}/${a.slug}`},props:{type,airport:a,title:type==='airport'?`${a.name} 品牌入口与优惠码`:`${a.name} 购买前检查与优惠说明`}}))),...articles.map(entry=>({params:{path:`${entry.data.category}/${entry.id}`},props:{type:'article',title:entry.data.title,entry}}))];
}
const {type,title,category,topic,slug,airport:a,entry}=Astro.props as any;
const posts=(await getCollection('articles',a=>!a.data.draft)).sort((a,b)=>b.data.updated.getTime()-a.data.updated.getTime());
const rendered=entry?await render(entry):null;const Content=rendered?.Content;
const current=Astro.url.pathname;
const parents:any={recommend:'需求选择',ranking:'排行榜',airport:'品牌资料',review:'购买检查',guides:'使用教程',blog:'博客文章',glossary:'知识百科'};
const group=current.split('/')[1];
const description=entry?.data.description??topic?.answer??(a?(type==='review'?`${a.name} 购买检查：查看运营者提供的推广入口与优惠码，以及套餐、线路和优惠条件的待核实清单。没有品牌级实测。`:`${a.name} 品牌入口与优惠码：由运营者提供，查看注册链接、优惠代码与待核实信息；套餐、价格和有效期尚未核实。`):`${title}：公开资料来源、比较方法、适合人群与未核实事项，帮助读者作出有依据的选择。`);
const noindex=type==='ranking'||((type==='airport'||type==='review')&&a.testStatus==='unverified')||(type==='topic'&&topic.slug==='premium');
const crumbs=current===`/${group}/`?[{name:parents[group],url:current}]:[{name:parents[group],url:`/${group}/`},{name:title,url:current}];
const related=entry?posts.filter(p=>p.id!==entry.id&&p.data.tags.some(t=>entry.data.tags.includes(t))).slice(0,3):posts.filter(p=>p.data.category==='blog').slice(0,3);
let schema:any[]=[];
if(type==='review') schema=[{'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:siteUpdated,dateModified:a.lastVerified||siteUpdated,author:{'@type':'Organization',name:'梯子中心'},mainEntityOfPage:`https://tizicenter.blog${current}`,citation:a.sources}];
if(entry) schema=[{'@context':'https://schema.org','@type':'BlogPosting',headline:title,description,datePublished:entry.data.published.toISOString(),dateModified:entry.data.updated.toISOString(),author:{'@type':'Organization',name:'梯子中心'},mainEntityOfPage:`https://tizicenter.blog${current}`}];

---
<Layout title={title} description={description} noindex={noindex} crumbs={crumbs} schema={schema} article={!!entry} published={entry?.data.published.toISOString()} updated={entry?.data.updated.toISOString()}><div class="container"><div class="page-intro"><span class="eyebrow">{type==='article'?'TIZI CENTER / KNOWLEDGE':'TIZI CENTER / EDITORIAL'}</span><h1>{title}</h1><p>{description}</p>{type!=='hub'&&<p class="small">{entry?'发布 / 更新':'资料整理 / 更新'}：{entry?entry.data.updated.toISOString().slice(0,10):a?.lastVerified||siteUpdated} · <a href="/editorial-policy/">查看编辑标准</a></p>}</div>
{type==='article'&&<><div class="article-layout"><article class="prose">{Content&&<Content/>}<h2>资料来源</h2><div class="sources">{entry.data.sources.map((s:string)=><a href={s} target="_blank" rel="noopener noreferrer">{s} ↗</a>)}</div></article><aside class="sidebar"><strong>本文目录</strong>{rendered?.headings.filter((h:any)=>h.depth===2).map((h:any)=><a href={`#${h.slug}`}>{h.text}</a>)}<strong>相关入口</strong><a href="/recommend/">按需求选择</a><a href="/compare/">横向比较工具</a><a href="/glossary/">基础术语</a></aside></div><section class="section"><h2>继续阅读</h2><ArticleCards items={related}/></section></>}
{type==='hub'&&<section class="section">{category==='recommend'?<div class="topic-grid">{topics.map(t=><a class="topic" href={`/recommend/${t.slug}/`}><span class="topic-icon">{t.symbol}</span><div><strong>{t.name}</strong><small>{t.summary}</small></div></a>)}</div>:category==='ranking'?<><div class="notice">排名依据公开。当前没有速度与稳定性实测，资料完整度不能解释为服务质量评分。</div><div class="article-grid">{[['overall','综合资料完整度','资料待核实，不发布名次'],['budget','低预算方案','价格与优惠条件待核实'],['value','每 GB 成本','有限流量单价计算规则'],['stable','稳定性测试标准','待实测，不发布名次']].map(([s,n,d])=><a class="article-card" href={`/ranking/${s}/`}><h2>{n}</h2><p>{d}</p><span class="text-link">查看依据 ↗</span></a>)}</div></>:category==='airport'?<><div class="notice">共 {airports.length} 个机场品牌与 {airports.filter(a=>a.couponCode).length} 个优惠码，均由运营者提供。展示顺序不是排名；推广入口、优惠有效性及套餐条件尚未核实。</div><div class="brand-grid">{airports.map(a=><BrandCard airport={a}/>)}</div></>:category==='review'?<><div class="notice">以下为品牌购买检查页，汇总运营者提供的入口、优惠码与待核实项目；尚无独立实测。</div><div class="article-grid">{airports.map(a=><a class="article-card" href={`/review/${a.slug}/`}><span class="eyebrow">运营者提供 · 待核实</span><h2>{a.name}</h2><p>{a.description}</p><span class="text-link">阅读资料评析 ↗</span></a>)}</div></>:<ArticleCards items={posts.filter(a=>a.data.category===category)}/>}</section>}
{type==='topic'&&<><div class="article-layout"><article class="prose"><h2>先给结论</h2><p>{topic.answer}</p><h2>选择时逐项检查</h2><ul>{topic.checks.map((c:string)=><li>{c}</li>)}</ul><h2>怎样进行小范围验证</h2><p>把真实使用任务列成清单：使用的设备、每天可接受的费用、需要的流量和目标服务。在付款前保存条款与官方资料的核验日期。先测试连接和账户访问，再观察正常工作时段与高峰时段的表现。记录问题发生条件，避免把本地网络故障误认为品牌质量差异。</p><h2>常见问题</h2><h3>这个专题保证品牌可用吗？</h3><p>不保证。官方资料只证明公开方案与说明存在，无法替代你所在网络的实际测试。本网站当前没有品牌级连接样本。</p><h3>有长期优惠时应该立即购买吗？</h3><p>先核对一次性支付总额、续费价和退款窗口，并评估条款变化风险。短期验证通常比单看月均折扣更能减少不确定性。</p><h2>下一步</h2><p><a href="/ranking/budget/">查看低预算核验标准</a>，再用 <a href="/compare/">比较工具</a> 核对资料差异。若使用机场订阅，先读 <a href="/blog/airport-vs-vpn/">机场与 VPN 的区别</a>。</p></article><aside class="sidebar"><strong>相关专题</strong>{topics.filter(t=>t.slug!==topic.slug).slice(0,3).map(t=><a href={`/recommend/${t.slug}/`}>{t.name}</a>)}<strong>比较方法</strong><a href="/ranking/overall/">资料完整度标准</a><a href="/blog/plan-cost/">套餐成本计算</a></aside></div><section class="section"><h2>有出处的参考资料</h2>{topic.brands.length?<div class="brand-grid">{airports.filter(a=>topic.brands.includes(a.id)).map(a=><BrandCard airport={a}/>)}</div>:<div class="empty">尚无符合本专题要求的品牌级核验数据。当前不发布推荐名次。</div>}</section></>}
{(type==='airport'||type==='review')&&<><div class="notice">信息由运营者提供，尚未进行官网身份、套餐或服务实测核验。以下链接为推广入口，通过其注册或购买，本站可能获得佣金。</div><div class="article-layout"><article class="prose"><h2>品牌入口与优惠码</h2><p>{a.description}</p><a class="button" href={a.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">访问 {a.name} 推广入口 ↗</a><Coupon airport={a}/><h2>优惠使用前确认</h2><p>如已提供优惠码，可在服务商结算页面输入，保留原始大小写。确认实际优惠金额、适用套餐、到期时间及是否可以叠加后再付款。本网站未验证代码能否使用，不承诺固定折扣。</p><h2>套餐价格与流量</h2><div class="table-wrap"><table><thead><tr><th>价格</th><th>流量</th><th>计费周期</th><th>流量倍率</th></tr></thead><tbody><tr><td>{price(a)}</td><td>{traffic(a)}</td><td>尚未核实</td><td>尚未核实</td></tr></tbody></table></div><p>运营者本次没有提供套餐资料。月付、年付、不限时方案与不同币种需要分开比较；价格和流量未确认前不计算每 GB 成本。</p><h2>线路、协议与设备限制</h2><p>节点地区、线路类型、协议、设备数和客户端兼容性：尚未核实。品牌名称或推广地址不能证明这些服务条件。</p><h2>AI、流媒体与稳定性</h2><p>AI 支持、流媒体兼容性、连接速度和稳定性：尚未核实。本站没有该品牌的原始测试记录，不使用宣传名称代替测试结论。</p><h2>购买前检查清单</h2><ul><li>确认访问页面的经营方、服务条款与支持入口。</li><li>核对付款总额、币种、周期、续费价和退款条件。</li><li>确认优惠码的实际抵扣结果及适用范围。</li><li>核对设备、流量、倍率与自己的实际任务需求。</li><li>如有试用或短期方案，先按 <a href="/guides/first-connection/">首次连接检查</a> 验证。</li></ul><h2>常见问题</h2><h3>这个优惠码保证有效吗？</h3><p>不保证。代码来自运营者提供，有效性、优惠幅度与有效期均尚未核实，以结算页面为准。</p><h3>这个页面属于实测评测吗？</h3><p>不属于。当前仅整理品牌入口与优惠码，未评价服务质量或适合人群。</p><h2>来源与更新时间</h2><p>来源：运营者提供的品牌名称、推广 URL 与优惠码。整理日期：{a.submittedAt}。独立核验日期：{a.lastVerified||unknown}。</p><h2>继续比较</h2><p><a href="/compare/">将品牌加入横向比较</a>，查看优惠码及资料缺口；也可返回 <a href="/airport/">全部品牌与优惠码目录</a>。</p></article><aside class="sidebar"><strong>阅读路线</strong><a href={type==='review'?`/airport/${a.slug}/`:`/review/${a.slug}/`}>{type==='review'?'品牌入口与优惠码':'购买前检查'}</a><a href="/compare/">对比其他品牌</a><a href="/blog/purchase-checklist/">购买前检查清单</a><a href="/editorial-policy/">推广披露</a></aside></div></>}
{type==='ranking'&&<><div class="notice">目前全部品牌的套餐、线路与实测资料尚未核实，本页不发布名次，并已设为不收录。</div><section class="prose"><h2>当前结论</h2><p>运营者提供了品牌名称、推广入口及部分优惠码；这些信息不足以形成性能、稳定性或价格排序。推广地址存在不等于官网身份已验证，优惠码也不能直接换算成已核实折扣。</p><h2>发布榜单前需要哪些资料</h2><p>{slug==='overall'?'补齐品牌来源、套餐条件、设备与协议说明，并公开评价规则。未核实条目不参与评分。':slug==='budget'?'核验实际付款总额、币种、周期和优惠使用条件；不同币种不能未经汇率核验混排。':slug==='value'?'价格、实际可用流量、重置周期与倍率必须核实。每 GB 单价 = 套餐价格 /（标称流量 ÷ 倍率）；不混排年付、不限时或不限流量方案。':'测试必须记录设备、客户端、网络、节点、时段与次数，保留连接成功率、丢包、断线与恢复原始记录。'}</p><h2>你现在可以查看</h2><p><a href="/airport/">全部品牌与优惠码目录</a> · <a href="/compare/">品牌横向比较</a> · <a href="/blog/purchase-checklist/">购买前检查清单</a></p></section><div class="empty">暂无符合核验要求的排名数据，不生成品牌名次。</div></>}

</div></Layout>
