---
import Layout from '../../layouts/Layout.astro';
import {airports} from '../../data/airports';
import {brandReferences} from '../../data/brand-references';
import {brandInformation} from '../../data/brand-information';
const sourceCount=new Set(brandReferences.flatMap(r=>r.sources.map(s=>s.url))).size;
const offerCount=brandReferences.reduce((n,r)=>n+r.offers.length,0);
const conflicts=brandReferences.filter(r=>r.hasConflict).length;
---
<Layout title="全部品牌信息状态与核对进度" description="查看29个品牌的8项信息状态、来源记录、优惠码与资料分歧，按状态筛选并进入品牌逐项核对清单。" crumbs={[{name:'品牌资料进度',url:'/brand-updates/'}]}>
<div class="container"><div class="page-intro"><span class="eyebrow">INFORMATION & EVIDENCE</span><h1>每个品牌，都有明确的信息状态。</h1><p>29 家品牌逐项记录：入口、公开来源、资料分歧、套餐、优惠码、退款、服务限制与实测。先看证据覆盖，再决定还需要确认什么。</p></div>
<div class="research-summary"><div><strong>{brandInformation.length}</strong><span>品牌已建立逐项状态</span></div><div><strong>{sourceCount}</strong><span>引用公开页面</span></div><div><strong>{offerCount}</strong><span>第三方参考价目</span></div><div><strong>{conflicts}</strong><span>存在来源分歧</span></div></div>
<div class="information-legend"><span><b class="information-badge provided">已提供</b> 运营者提交</span><span><b class="information-badge recorded">已整理</b> 有来源可查</span><span><b class="information-badge conflict">有分歧</b> 保留不同说法</span><span><b class="information-badge pending">待官方确认</b> 证据仍不足</span></div>
<section class="budget-explainer"><h2>本轮整理 · 2026-10-13</h2><p>全部品牌的 8 项状态已补齐，共 232 项。11 家有运营者提供的优惠码，18 家未提供；优惠有效性均未完成结算验证。每家品牌详情保留来源、参考报价及具体条件缺口。</p><p>“公开资料已整理”不等于当前商城已核实。本站尚未独立确认经营主体、当前在售条款与实际连接表现；第三方记录不进入已核实价格排名。日期表示阅读时间，各来源的报价日期在品牌详情另列。</p></section>
<div class="status-filter"><label for="information-filter">快速筛选</label><select id="information-filter"><option value="all">全部品牌</option><option value="conflict">有来源分歧</option><option value="coupon">已提供优惠码</option><option value="no-coupon">未提供优惠码</option></select><span id="information-count" role="status" aria-live="polite">显示 {airports.length} 家品牌</span></div>
<div class="table-wrap research-progress" tabindex="0" role="region" aria-label="品牌信息状态，可横向滚动"><table><caption>全部品牌信息状态 · 非质量排名</caption><thead><tr><th scope="col">品牌</th><th scope="col">信息状态</th><th scope="col">来源 / 参考价目</th><th scope="col">优惠码状态</th><th scope="col">最近查阅</th><th scope="col">待确认项目</th></tr></thead><tbody>{brandInformation.map(info=>{const brand=airports.find(a=>a.slug===info.slug)!;return <tr data-information-row data-conflict={String(info.hasConflict)} data-coupon={String(!!brand.couponCode)}><td><a href={"/airport/"+info.slug+"/#research-status"}>{info.name}</a><small>查看 8 项核对清单 ↗</small></td><td><span class:list={['information-badge',info.hasConflict?'conflict':'recorded']}>{info.summary}</span></td><td>{info.sourceCount} 个 / {info.offerCount} 条</td><td>{brand.couponCode?<><code>{brand.couponCode}</code><small>已提供 · 未验证</small></>:'未提供'}</td><td><time datetime={info.reviewedAt}>{info.reviewedAt??'暂无记录'}</time></td><td>经营方、现价、退款、限制与实测<small>具体缺口见品牌详情</small></td></tr>;})}</tbody></table></div>
<p id="information-empty" class="status-no-results" hidden>没有符合此状态的品牌。</p><p class="small muted">同一页面可能被多个品牌引用，页面数按地址去重；参考价目包含不同来源版本，不代表当前在售套餐数量。</p><div class="actions"><a class="button" href="/airport/">返回品牌目录</a><a class="button secondary" href="/compare/">横向比较品牌</a><a class="button secondary" href="/contact/">提供资料纠错</a></div></div>
<script>
const filter=document.querySelector<HTMLSelectElement>('#information-filter')!;
const rows=[...document.querySelectorAll<HTMLElement>('[data-information-row]')];
function render(){let count=0;for(const row of rows){const show=filter.value==='all'||filter.value==='conflict'&&row.dataset.conflict==='true'||filter.value==='coupon'&&row.dataset.coupon==='true'||filter.value==='no-coupon'&&row.dataset.coupon==='false';row.hidden=!show;if(show)count++;}document.querySelector('#information-count')!.textContent=`显示 ${count} 家品牌`;document.querySelector<HTMLElement>('#information-empty')!.hidden=count>0;const url=new URL(location.href);url.searchParams.delete('status');if(filter.value!=='all')url.searchParams.set('status',filter.value);history.replaceState(null,'',url);}
function restore(){const requested=new URLSearchParams(location.search).get('status')||'all';filter.value=['all','conflict','coupon','no-coupon'].includes(requested)?requested:'all';render();}
filter.addEventListener('change',render);window.addEventListener('popstate',restore);restore();
</script>
</Layout>
