---
import Layout from '../../layouts/Layout.astro';
import {airports,price,traffic,unknown,cost} from '../../data/airports';
const rows=airports.map(a=>({slug:a.slug,name:a.name,values:[price(a),traffic(a),cost(a.plans[0])===undefined?'不适用 / 尚未核实':`${a.currency} ${cost(a.plans[0])?.toFixed(3)} / GB`,a.regions.join('、')||unknown,a.protocols.join('、')||unknown,a.deviceLimit||unknown,a.aiSupport?.join('、')||unknown,a.streamingSupport?.join('、')||unknown,a.advantages.join('；'),a.disadvantages.join('；')]}));
---
<Layout title="机场与 VPN 横向比较工具：价格、流量与资料缺口" description="选择 2–4 家真实 VPN 品牌比较官方套餐、流量、协议、设备限制和未核实事项；不同币种与不同计费周期分别展示。" crumbs={[{name:'横向比较',url:'/compare/'}]}><div class="container"><div class="page-intro"><span class="eyebrow">COMPARE WITH CONTEXT</span><h1>选择之前，放在一起看</h1><p>选择 2–4 家品牌。所有资料来自统一数据库，未核实字段保持明确标注。</p></div><div class="notice">当前收录的是 VPN 品牌。机场订阅资料待核验后加入；不限流量不计算每 GB 成本，币种不直接换算。</div><fieldset style="border:0;padding:0"><legend>选择候选品牌（最多 4 家）</legend><div class="selector">{airports.map(a=><label><input type="checkbox" value={a.slug}/>{a.name}</label>)}</div></fieldset><p id="compare-status" role="status" aria-live="polite">请选择至少 2 家品牌开始比较。</p><div id="compare-table" class="table-wrap comparison"></div><noscript><div class="notice">交互比较需要 JavaScript；以下静态资料始终可读。</div></noscript><section class="section"><h2>全部品牌的静态资料</h2><div class="table-wrap"><table><thead><tr><th>品牌</th><th>价格</th><th>流量</th><th>详细资料</th></tr></thead><tbody>{airports.map(a=><tr><td>{a.name}</td><td>{price(a)}</td><td>{traffic(a)}</td><td><a href={`/airport/${a.slug}/`}>查看来源与限制 ↗</a></td></tr>)}</tbody></table></div></section></div><script type="application/json" id="compare-data" set:html={JSON.stringify(rows).replace(/</g,'\\u003c')}/><script>
const data=JSON.parse(document.querySelector('#compare-data')!.textContent!);const checks=[...document.querySelectorAll<HTMLInputElement>('.selector input')];const labels=['价格','套餐流量','每 GB 成本','节点地区','协议','设备限制','AI 支持','流媒体支持','优点','注意事项'];const status=document.querySelector('#compare-status')!;const target=document.querySelector('#compare-table')!;
function render(){const selected=checks.filter(c=>c.checked);checks.forEach(c=>c.disabled=selected.length>=4&&!c.checked);target.replaceChildren();status.textContent=selected.length<2?'请选择至少 2 家品牌开始比较。':`正在比较 ${selected.length} 家品牌；最多可选择 4 家。`;if(selected.length<2)return;const items=selected.map(c=>data.find((a:any)=>a.slug===c.value));const table=document.createElement('table');const caption=document.createElement('caption');caption.textContent='品牌官方资料横向比较';caption.style.padding='14px';table.append(caption);const head=document.createElement('thead');const hr=document.createElement('tr');const corner=document.createElement('th');corner.textContent='比较维度';hr.append(corner);for(const a of items){const th=document.createElement('th');th.scope='col';th.append(document.createTextNode(a.name+' '));const b=document.createElement('button');b.className='remove';b.textContent='移除';b.setAttribute('aria-label',`移除 ${a.name}`);b.onclick=()=>{checks.find(c=>c.value===a.slug)!.checked=false;render();checks.find(c=>c.value===a.slug)!.focus();};th.append(b);hr.append(th);}head.append(hr);table.append(head);const body=document.createElement('tbody');labels.forEach((label,i)=>{const tr=document.createElement('tr');const th=document.createElement('th');th.scope='row';th.textContent=label;tr.append(th);for(const a of items){const td=document.createElement('td');td.textContent=a.values[i];tr.append(td);}body.append(tr);});table.append(body);target.append(table);}
checks.forEach(c=>c.addEventListener('change',render));render();
</script></Layout>
