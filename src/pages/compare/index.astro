---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import {brandReferences} from '../../data/brand-references';
import {getBrandInformation} from '../../data/brand-information';
const referenceSummary=(slug:string)=>{const r=brandReferences.find(item=>item.slug===slug);return r?[`${r.sources.length} 个第三方来源 · ${r.offers.length} 条历史报价记录`,r.hasConflict?'有来源分歧 · 详情保留冲突':'当前条款仍待确认']:['暂无公开参考','资料待补充'];};
import {airports,price,traffic,unknown,cost} from '../../data/airports';
const rows=airports.map(a=>({slug:a.slug,name:a.name,values:[price(a),traffic(a),cost(a.plans[0])===undefined?'不适用 / 尚未核实':`${a.currency} ${cost(a.plans[0])?.toFixed(3)} / GB`,a.regions.join('、')||unknown,a.protocols.join('、')||unknown,a.deviceLimit||unknown,a.aiSupport?.join('、')||unknown,a.streamingSupport?.join('、')||unknown,a.advantages.join('；')||unknown,a.disadvantages.join('；')||unknown,a.couponCode||'未提供',getBrandInformation(a.slug).summary,...referenceSummary(a.slug),getBrandInformation(a.slug).reviewedAt||'暂无记录']}));
---
<Layout title="机场与 VPN 横向比较工具：优惠码与品牌资料" description="从 29 个机场品牌中搜索并选择 2–4 家，对比优惠码与资料状态。可查看全部价格、流量、协议等字段，未核实内容明确标注。" crumbs={[{name:'横向比较',url:'/compare/'}]}>
 <div class="container"><div class="page-intro"><span class="eyebrow">COMPARE WITH CONTEXT</span><h1>把候选放在一起，信息更清楚。</h1><p>搜索品牌，选择 2–4 家。先比较优惠码、第三方来源覆盖和资料分歧，再查看仍需核实的服务条件；历史记录不代表当前报价。</p></div>
 <section class="compare-workspace" aria-label="品牌选择"><fieldset><legend>添加比较品牌 <span class="muted small">最多 4 家</span></legend><div class="compare-tools"><div class="directory-search"><Icon name="search" size={18}/><label class="sr-only" for="candidate-query">搜索比较品牌</label><input type="search" id="candidate-query" placeholder="搜索品牌中文名或英文名" autocomplete="off"/></div><span class="compare-selection-meta" id="candidate-count">{airports.length} 个候选</span></div><div class="selector">{airports.map(a=><label data-candidate={`${a.name} ${a.slug}`.toLowerCase()}><input type="checkbox" value={a.slug}/><span>{a.name}</span></label>)}</div><p id="candidate-empty" class="compare-no-candidates" hidden>没有匹配候选，试试其他名称。</p></fieldset><div class="selection-tray" id="selection-tray" hidden></div></section>
 <div class="compare-toolbar"><p id="compare-status" role="status" aria-live="polite">请选择至少 2 家品牌开始比较。</p><label><input type="checkbox" id="show-all-fields"/>显示全部资料字段</label></div>
 <div id="compare-table"><div class="compare-empty"><Icon name="compare" size={35}/><h2>从两个候选开始</h2><p>上方选中的品牌会出现在这里，随时可以添加或移除。</p></div></div>
 <div class="disclosure"><Icon name="shield" size={17}/><p>品牌入口与优惠码由运营者提供，套餐及优惠有效性尚未核实。公开参考来自第三方，记录条数不代表服务质量；报价冲突请进入品牌详情核对。全部资料字段可以展开，不为未知套餐计算成本。</p></div>
 <noscript><p class="notice">交互比较需要 JavaScript；下方全部品牌的静态资料仍可浏览。</p></noscript>
 <details class="static-compare"><summary>浏览全部 {airports.length} 个品牌的静态资料</summary><div class="table-wrap"><table><thead><tr><th>品牌</th><th>优惠码</th><th>资料状态</th><th>详情</th></tr></thead><tbody>{airports.map(a=><tr><td>{a.name}</td><td>{a.couponCode||'未提供'}</td><td>{getBrandInformation(a.slug).summary}</td><td><a class="text-link" href={`/airport/${a.slug}/`}>查看品牌 <Icon name="arrow" size={14}/></a></td></tr>)}</tbody></table></div></details>
 </div>
 <script type="application/json" id="compare-data" set:html={JSON.stringify(rows).replace(/</g,'\\u003c')}/>
 <script>
const data=JSON.parse(document.querySelector('#compare-data')!.textContent!);
const checks=[...document.querySelectorAll<HTMLInputElement>('.selector input')];
const labels=['价格','套餐流量','每 GB 成本','节点地区','协议','设备限制','AI 支持','流媒体支持','优点','注意事项','优惠码','信息状态','第三方公开参考','资料差异','资料查阅日期'];
const status=document.querySelector('#compare-status')!;
const target=document.querySelector<HTMLElement>('#compare-table')!;
const tray=document.querySelector<HTMLElement>('#selection-tray')!;
const showAll=document.querySelector<HTMLInputElement>('#show-all-fields')!;
const query=document.querySelector<HTMLInputElement>('#candidate-query')!;
function remove(slug:string){const checkbox=checks.find(c=>c.value===slug)!;checkbox.checked=false;render();if(checkbox.closest<HTMLElement>('label')!.hidden)query.focus();else checkbox.focus();}
function filter(){const q=query.value.trim().toLowerCase();let count=0;checks.forEach(c=>{const label=c.closest<HTMLElement>('label')!;label.hidden=!label.dataset.candidate!.includes(q);if(!label.hidden)count++;});document.querySelector('#candidate-count')!.textContent=`${count} 个候选`;document.querySelector<HTMLElement>('#candidate-empty')!.hidden=count>0;}
function render(){
 const selected=checks.filter(c=>c.checked);
 const url=new URL(location.href);url.searchParams.delete('brands');if(selected.length)url.searchParams.set('brands',selected.map(c=>c.value).join(','));history.replaceState(null,'',url);
 const items=selected.map(c=>data.find((a:any)=>a.slug===c.value));
 checks.forEach(c=>c.disabled=selected.length>=4&&!c.checked);
 tray.replaceChildren();tray.hidden=!items.length;
 for(const a of items){const chip=document.createElement('span');chip.className='selected-chip';chip.append(document.createTextNode(a.name));const b=document.createElement('button');b.textContent='×';b.setAttribute('aria-label',`取消选择 ${a.name}`);b.onclick=()=>remove(a.slug);chip.append(b);tray.append(chip);}
 if(items.length){const clear=document.createElement('button');clear.className='clear-selection';clear.textContent='清空选择';clear.onclick=()=>{checks.forEach(c=>c.checked=false);render();query.focus();};tray.append(clear);}
 target.replaceChildren();
 status.textContent=selected.length<2?selected.length===1?'已选择 1 家，再添加 1 家开始比较。':'请选择至少 2 家品牌开始比较。':`正在比较 ${selected.length} 家品牌 · 最多可选择 4 家`;
 if(selected.length<2){const empty=document.createElement('div');empty.className='compare-empty';const h=document.createElement('h2');h.textContent=selected.length?'再添加一个品牌，即可开始比较':'从两个候选开始';const p=document.createElement('p');p.textContent='在上方搜索并选择品牌，已选项目随时可以移除。';empty.append(h,p);target.append(empty);return;}
 const wrapper=document.createElement('div');wrapper.className='table-wrap comparison';
 const table=document.createElement('table');const caption=document.createElement('caption');caption.textContent='品牌横向资料比较';table.append(caption);
 const head=document.createElement('thead');const hr=document.createElement('tr');const corner=document.createElement('th');corner.textContent='比较维度';corner.scope='col';hr.append(corner);
 for(const a of items){const th=document.createElement('th');th.scope='col';const link=document.createElement('a');link.textContent=a.name;link.href=`/airport/${a.slug}/`;th.append(link);const b=document.createElement('button');b.className='remove';b.textContent='移除';b.setAttribute('aria-label',`移除 ${a.name}`);b.onclick=()=>remove(a.slug);th.append(b);hr.append(th);}
 head.append(hr);table.append(head);const body=document.createElement('tbody');
 labels.forEach((label,i)=>{if(!showAll.checked&&i<10)return;const tr=document.createElement('tr');const th=document.createElement('th');th.scope='row';th.textContent=label;tr.append(th);for(const a of items){const td=document.createElement('td');td.textContent=a.values[i];if(i===11){const link=document.createElement('a');link.className='information-detail-link';link.textContent='查看逐项核对 ↗';link.href=`/airport/${a.slug}/#research-status`;td.append(link);}tr.append(td);}body.append(tr);});
 table.append(body);wrapper.append(table);target.append(wrapper);
}
const requested=[...new Set((new URLSearchParams(location.search).get('brands')||'').split(','))].filter(slug=>checks.some(c=>c.value===slug)).slice(0,4);
checks.forEach(c=>{c.checked=requested.includes(c.value);c.addEventListener('change',render);});
query.addEventListener('input',filter);showAll.addEventListener('change',render);render();filter();
 </script>
</Layout>
