import Layout from '../../layouts/Layout.astro';
---
<Layout title="联系与资料纠错" description="发现资料与原始来源不一致时，请提供页面地址、具体字段、官方链接和发现日期。" crumbs={[{name:"联系与资料纠错",url:'/contact/'}]}><div class="container"><div class="page-intro"><span class="eyebrow">TIZI CENTER / TRUST</span><h1>联系与资料纠错</h1><p>发现资料与原始来源不一致时，请提供页面地址、具体字段、官方链接和发现日期。</p></div><article class="prose" style="max-width:800px"><h2>我们的说明</h2><p>当前公开纠错渠道为项目 GitHub Issues。请附上原始来源与发现日期，便于核对具体字段。请勿在公开工单提交账户、支付信息、订阅链接或任何访问令牌。</p><h2>怎样提供可核对的纠错资料</h2><p>请注明品牌、本站页面地址、需更正的字段、原始公开来源及发现日期。说明价格对应的币种和付款周期，流量属于每月额度还是整个周期总量。</p><h2>当前状态与适用范围</h2><p>本站无法替品牌处理退款或连接问题；服务问题请通过该品牌的官方支持入口解决。</p><p><a href="https://github.com/ksugiono187/tizicenter.blog/issues" target="_blank" rel="noopener noreferrer">在 GitHub 提交资料纠错 ↗</a></p><p>更新日期：2026-10-13</p><p><a href="/editorial-policy/">编辑政策</a> · <a href="/contact/">资料纠错</a> · <a href="/airport/">品牌来源库</a></p><div id="brand-correction-context" hidden class="notice"></div><p><a href="/brand-updates/">查看品牌资料进度与本轮更新</a></p></article></div><script>const brand=new URLSearchParams(location.search).get('brand');const context=document.querySelector<HTMLElement>('#brand-correction-context');if(brand&&context&&/^[a-z0-9-]{1,40}$/.test(brand)){context.hidden=false;context.textContent='当前品牌标识：'+brand+'。提交纠错时请附上该品牌页面地址与具体字段。';}</script></Layout>