---
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import BrandMark from '../components/BrandMark.astro';
import Coupon from '../components/Coupon.astro';
import ArticleCards from '../components/ArticleCards.astro';
import Icon from '../components/Icon.astro';
import {airports} from '../data/airports';
import {topics} from '../data/topics';
import {getCollection} from 'astro:content';
const posts=(await getCollection('articles',a=>!a.data.draft)).sort((a,b)=>b.data.updated.getTime()-a.data.updated.getTime());
const coupons=airports.filter(a=>a.couponCode);
const topicIcons:Record<string,string>={budget:'wallet',premium:'globe',beginner:'book',stable:'activity',ai:'spark',streaming:'play'};
const reads=['choose-service','plan-cost','purchase-checklist'].map(id=>posts.find(p=>p.id===id)!).filter(Boolean);
---
<Layout title="机场推荐与 VPN 选择指南：品牌、优惠与使用教程" description={`梯子中心整理 29 个机场品牌、11 个优惠码与 ${posts.length} 篇教程和知识文章。搜索品牌、横向比较、复制优惠码，按平台学习订阅配置与问题排查。`}>
 <section class="hero"><div class="container hero-grid">
  <div class="hero-copy"><span class="eyebrow hero-eyebrow"><span class="eyebrow-line"></span>TIZI CENTER / 连接知识与选择指南</span><h1>机场推荐与 VPN 指南<br/><em>把复杂的选择，变简单。</em></h1><p>查品牌，找优惠，读教程。<br class="desktop-break"/>从清楚的信息出发，为你的网络需求作出选择。</p><div class="actions"><a class="button" href="/airport/">浏览品牌目录 <Icon name="arrow" size={18}/></a><a class="button secondary" href="#coupons"><Icon name="gift" size={18}/>查看优惠码</a></div><div class="hero-proof"><span><Icon name="grid" size={15}/>{airports.length} 个品牌</span><span><Icon name="gift" size={15}/>{coupons.length} 个优惠码</span><span><Icon name="book" size={15}/>{posts.length} 篇指南</span></div></div>
  <aside class="explore-panel" aria-label="网站快捷入口"><div class="explore-head"><span class="eyebrow">EXPLORE THE DIRECTORY</span><span class="badge">2026.10 更新</span></div><h2>你要找的，集中在这里。</h2><div class="brand-orbit">{airports.slice(0,5).map(a=><a href={`/airport/${a.slug}/`} aria-label={`查看 ${a.name}`}><BrandMark airport={a}/></a>)}<a class="orbit-more" href="/airport/" aria-label="浏览全部29个品牌">+24</a></div><div class="explore-links"><a href="/airport/"><span class="explore-icon"><Icon name="grid"/></span><div><strong>品牌资料库</strong><small>名称、入口与购买检查</small></div><span class="explore-count">{airports.length}</span><Icon name="chevron" size={15}/></a><a href="/airport/?filter=coupon"><span class="explore-icon mint"><Icon name="gift"/></span><div><strong>优惠码合集</strong><small>保留原始大小写，一键复制</small></div><span class="explore-count">{coupons.length}</span><Icon name="chevron" size={15}/></a><a href="/guides/"><span class="explore-icon lilac"><Icon name="book"/></span><div><strong>入门教程</strong><small>从安装到第一次连接</small></div><span class="explore-count">{posts.filter(p=>p.data.category==='guides').length}</span><Icon name="chevron" size={15}/></a></div></aside>
 </div></section>
 <div class="container editorial-strip"><span><Icon name="shield" size={18}/><strong>让信息说清楚</strong></span><p>推广关系明确披露 · 优惠条件需在结算页确认 · 未实测不下结论</p><a href="/editorial-policy/">我们的编辑标准 <Icon name="arrow" size={15}/></a></div>
 <section class="section home-brands" id="brands"><div class="container"><div class="section-head"><div><span class="eyebrow">01 / BRAND DIRECTORY</span><h2>从品牌入口开始</h2><p>先找到入口，再核对套餐与优惠。以下按目录顺序展示，不代表排名。</p></div><a class="text-link" href="/airport/">查看全部 {airports.length} 个品牌 <Icon name="arrow" size={16}/></a></div><div class="brand-grid">{airports.slice(0,6).map(a=><BrandCard airport={a}/>)}</div><div class="disclosure"><Icon name="shield" size={17}/><p>品牌链接为推广入口，本站可能获得佣金。套餐、优惠有效性及实际表现尚未核实。</p></div></div></section>
 <section class="section coupon-section" id="coupons"><div class="container"><div class="section-head"><div><span class="eyebrow">02 / COUPON COLLECTION</span><h2>优惠码，不用到处找</h2><p>已整理 {coupons.length} 个代码。复制后，请在结算页确认优惠金额与适用条件。</p></div><a class="text-link" href="/airport/?filter=coupon">筛选有优惠码的品牌 <Icon name="arrow" size={16}/></a></div><div class="coupon-grid">{coupons.map(a=><article class="coupon-tile"><div class="coupon-brand"><BrandMark airport={a}/><a href={`/airport/${a.slug}/`}>{a.name}</a><Icon name="gift" size={18}/></div><Coupon airport={a} compact={true}/><a class="coupon-entry" href={a.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">前往推广入口 <Icon name="external" size={13}/></a></article>)}</div><p class="section-note"><Icon name="clock" size={15}/>代码由运营者提供，优惠幅度、有效期和适用套餐尚未核实；保留大小写使用。</p></div></section>
 <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">03 / CHOOSE BY NEED</span><h2>先明确需求，再看品牌</h2><p>预算、设备与实际任务，是选择的起点。</p></div><a class="text-link" href="/recommend/">全部选择专题 <Icon name="arrow" size={16}/></a></div><div class="topic-grid">{topics.map(t=><a class="topic" href={`/recommend/${t.slug}/`}><span class="topic-icon"><Icon name={topicIcons[t.slug]} size={23}/></span><div><strong>{t.name}</strong><small>{t.summary}</small></div><Icon name="chevron" size={17}/></a>)}</div></div></section>
 <section class="section section-tight"><div class="container"><div class="compare-banner"><div class="compare-banner-icon"><Icon name="compare" size={34}/></div><div><span class="eyebrow">COMPARE WITH CONTEXT</span><h2>选几个候选，放在同一张表里。</h2><p>选择 2–4 个品牌，比较优惠码和资料状态，找到仍需确认的信息。</p></div><a class="button" href="/compare/">打开比较工具 <Icon name="arrow" size={18}/></a></div></div></section>
 <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">04 / BEFORE YOU BUY</span><h2>下单之前，先读这三篇</h2><p>看完整账单、核对条款，让每一步都有依据。</p></div><a class="text-link" href="/blog/">更多选择指南 <Icon name="arrow" size={16}/></a></div><ArticleCards items={reads}/><div class="quick-grid">{[['01','从短期体验开始','先确认设备和网络能完成自己的任务。'],['02','看账单总额','月均优惠不等于可按月付款。'],['03','保护订阅凭据','截图或反馈时遮盖账户与访问令牌。'],['04','确认优惠条件','优惠码存在不代表任何套餐都适用。']].map(([n,t,d])=><div class="quick-item"><span>{n}</span><div><h3>{t}</h3><p>{d}</p></div></div>)}</div></div></section>
 <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">05 / GET CONNECTED</span><h2>你的设备，从这里开始</h2><p>软件下载、权限确认与连接检查，按平台一步步完成。</p></div><a class="text-link" href="/guides/">教程中心 <Icon name="arrow" size={16}/></a></div><div class="platforms">{[['windows','monitor','Windows'],['android','phone','Android'],['ios','phone','iOS / iPadOS'],['macos','laptop','macOS']].map(([s,i,n])=><a class="platform" href={`/guides/${s}/`}><span class="platform-symbol"><Icon name={i} size={29}/></span><strong>{n}</strong><p>安装与首次连接</p><span class="text-link">阅读教程 <Icon name="arrow" size={15}/></span></a>)}</div></div></section>
 <section class="section"><div class="container knowledge-split"><div class="knowledge-intro"><span class="eyebrow">06 / KNOW THE BASICS</span><h2>术语不复杂，<br/>解释要清楚。</h2><p>先弄清协议、DNS 与订阅链接，再判断服务是否符合自己的需求。</p><a class="text-link" href="/glossary/">进入知识百科 <Icon name="arrow" size={16}/></a></div><div class="glossary-list">{posts.filter(a=>a.data.category==='glossary').map((a,i)=><a href={`/glossary/${a.id}/`}><span class="glossary-number">0{i+1}</span><div><h3>{a.data.title.split('：')[0]}</h3><p>{a.data.description}</p></div><Icon name="arrow" size={18}/></a>)}</div></div></section>
 <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">07 / EDITORIAL PICKS</span><h2>继续阅读，做更清楚的选择</h2></div><a class="text-link" href="/blog/">全部知识文章 <Icon name="arrow" size={16}/></a></div><ArticleCards items={posts.filter(a=>a.data.category==='blog'&&!reads.includes(a)).slice(0,3)}/></div></section>
 <section class="section"><div class="container faq-section"><div><span class="eyebrow">08 / QUESTIONS & ANSWERS</span><h2>你可能还想知道</h2><p>资料边界写清楚，选择才能更明白。</p><a class="text-link" href="/contact/">发现错误？提交纠正 <Icon name="arrow" size={16}/></a></div><div class="faq">{[['机场与 VPN 是一回事吗？','“机场”在这里指提供代理订阅的服务，VPN 通常通过官方应用或隧道配置工作。交付方式与客户端可能不同，应按具体服务文档确认。'],['这些优惠码都能使用吗？','代码由运营者提供，有效性、优惠幅度和适用套餐尚未核实。复制后请在结算页查看实际抵扣，再确认付款。'],['为什么没有速度或稳定性排名？','目前没有本网站独立实测记录。官方宣传、推广地址和优惠码不能证明服务质量，因此不生成性能名次。'],['品牌目录的顺序代表推荐吗？','目录按运营者提供的顺序整理，不代表质量或性价比排名。请结合实际套餐、服务条款和自己的任务核对。']].map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
</Layout>
