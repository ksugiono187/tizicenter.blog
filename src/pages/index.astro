---
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import BrandMark from '../components/BrandMark.astro';
import Coupon from '../components/Coupon.astro';
import ReaderRoutes from '../components/ReaderRoutes.astro';
import EditorialFeatures from '../components/EditorialFeatures.astro';
import Icon from '../components/Icon.astro';
import {airports} from '../data/airports';
import {brandReferences} from '../data/brand-references';
const coupons=airports.filter(a=>a.couponCode);
const evidence=['lightspeed','sogoyun'].map(slug=>({airport:airports.find(a=>a.slug===slug)!,reference:brandReferences.find(r=>r.slug===slug)!}));
---
<Layout title="机场怎么选、套餐怎么算、连接怎么查：梯子中心深读指南" description="用任务卡筛选机场，按自己的用量计算套餐费用，按现象排查连接故障。梯子中心提供原创决策方法、假设案例、29品牌公开来源及150篇知识文章。">
<section class="reader-hero"><div class="container reader-hero-grid"><div class="reader-hero-copy"><span class="eyebrow">TIZI CENTER · 从问题到答案</span><h1>选套餐、算费用、查故障。<br/><em>每一步，知道为什么。</em></h1><p>从具体需求出发，看懂一笔账单，找到一个故障的起点。我们把判断过程和操作写清楚，让你读完就能用。</p><div class="actions"><a class="button" href="#reader-start">找到我的阅读起点 <Icon name="arrow" size={18}/></a><a class="button secondary" href="/blog/">浏览知识文章</a></div><div class="reader-hero-meta"><span>原创方法与假设案例</span><span>技术说明附官方出处</span><span>品牌资料标明缺口</span></div></div><a class="cover-story" href="/blog/plan-cost/"><div class="cover-meta"><span>编辑精选 / 预算观察</span><span>CASE STUDY 01</span></div><h2>20元150GB，<br/>就一定比年付更省钱？</h2><p>把同一组套餐放进三种用量，看看账单为何改变。</p><div class="cover-equation"><span>低标称单价</span><b>≠</b><span>低实际支出</span></div><div class="cover-footer"><small>完全假设的算例 · 不对应品牌报价</small><strong>读案例 ↗</strong></div></a></div></section>
<section class="reader-start section" id="reader-start"><div class="container"><div class="section-head"><div><span class="eyebrow">START WITH YOUR QUESTION</span><h2>你现在最想解决哪个问题？</h2><p>展开一条阅读路线。每一步都说明目的，读完能得到一份自己的记录。</p></div></div><ReaderRoutes/></div></section>
<section class="section editorial-main"><div class="container"><div class="section-head"><div><span class="eyebrow">THREE STORIES WORTH YOUR TIME</span><h2>先读这三份，再做决定。</h2><p>有完整推演、有明确下一步，也说明什么时候还不能下结论。</p></div><a class="text-link" href="/blog/">查看150篇知识文章 <Icon name="arrow" size={16}/></a></div><EditorialFeatures/></div></section>
<section class="section source-notebook"><div class="container"><div class="section-head"><div><span class="eyebrow">FROM THE SOURCE NOTEBOOK</span><h2>报价不能只截一行。</h2><p>同一品牌、相同价位，资料也可能给出不同答案。下面保留两组公开记录，方便你看清应当问什么。</p></div><a class="text-link" href="/brand-updates/">查看全部资料进度 ↗</a></div><div class="evidence-note-grid">{evidence.map(({airport:a,reference:r})=>{const rows=a.slug==='lightspeed'?r.offers.filter(o=>o.name==='光速云·极速版'||o.sourceId==='yp7'):r.offers.filter(o=>o.name==='基础版');return <article class="evidence-note"><span class="eyebrow">第三方公开记录 · 当前售价未核实</span><h3>{a.name}：两份价目先对照</h3><dl>{rows.map(o=><div><dt>{r.sources.find(s=>s.id===o.sourceId)?.publisher}</dt><dd>¥{o.amount} / {o.periodLabel}<span>{o.trafficLabel}</span></dd></div>)}</dl><p>不同版本可能对应不同档位或调整；现有记录无法确认原因。先核对当前订单，再计算费用。</p><a href={'/airport/'+a.slug+'/#public-references'}>查看来源、日期与待确认项 ↗</a></article>;})}</div><p class="section-note">本站查阅于2026-10-13；原资料日期与缺口见品牌详情。没有可比的商城记录时，不把版本差异写成涨价或降价。</p></div></section>
<section class="section reader-tool-section"><div class="container"><div class="reader-tool-banner"><div><span class="eyebrow">READ IT · TRY IT</span><h2>把文章里的方法，代入你的条件。</h2><p>费用计算器核对付款和理论额度；流量预算工具区分实际传输与后台已扣。公式和输入假设随结果展示。</p></div><div class="actions"><a class="button" href="/tools/cost/">算这笔费用 ↗</a><a class="button secondary" href="/tools/traffic/">估计流量 ↗</a></div></div></div></section>
 <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">DEVICE GUIDES</span><h2>你的设备，从这里开始</h2><p>软件下载、权限确认与连接检查，按平台一步步完成。</p></div><a class="text-link" href="/guides/">教程中心 <Icon name="arrow" size={16}/></a></div><div class="platforms">{[['windows','monitor','Windows'],['android','phone','Android'],['ios','phone','iOS / iPadOS'],['macos','laptop','macOS']].map(([s,i,n])=><a class="platform" href={`/guides/${s}/`}><span class="platform-symbol"><Icon name={i} size={29}/></span><strong>{n}</strong><p>安装与首次连接</p><span class="text-link">阅读教程 <Icon name="arrow" size={15}/></span></a>)}</div></div></section>
 <section class="section home-brands" id="brands"><div class="container"><div class="section-head"><div><span class="eyebrow">BRAND DIRECTORY</span><h2>准备好了，再查品牌资料</h2><p>先找到入口，再核对套餐与优惠。以下按目录顺序展示，不代表排名。</p></div><a class="text-link" href="/airport/">查看全部 {airports.length} 个品牌 <Icon name="arrow" size={16}/></a></div><div class="brand-grid">{airports.slice(0,6).map(a=><BrandCard airport={a}/>)}</div><div class="disclosure"><Icon name="shield" size={17}/><p>品牌链接为推广入口，本站可能获得佣金。套餐、优惠有效性及实际表现尚未核实。</p></div></div></section>
 <section class="section coupon-section" id="coupons"><div class="container"><div class="section-head"><div><span class="eyebrow">COUPON COLLECTION</span><h2>优惠码，不用到处找</h2><p>已整理 {coupons.length} 个代码。复制后，请在结算页确认优惠金额与适用条件。</p></div><a class="text-link" href="/airport/?filter=coupon">筛选有优惠码的品牌 <Icon name="arrow" size={16}/></a></div><div class="coupon-grid">{coupons.map(a=><article class="coupon-tile"><div class="coupon-brand"><BrandMark airport={a}/><a href={`/airport/${a.slug}/`}>{a.name}</a><Icon name="gift" size={18}/></div><Coupon airport={a} compact={true}/><a class="coupon-entry" href={a.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">前往推广入口 <Icon name="external" size={13}/></a></article>)}</div><p class="section-note"><Icon name="clock" size={15}/>代码由运营者提供，优惠幅度、有效期和适用套餐尚未核实；保留大小写使用。</p></div></section>
 <section class="section"><div class="container faq-section"><div><span class="eyebrow">QUESTIONS & ANSWERS</span><h2>你可能还想知道</h2><p>资料边界写清楚，选择才能更明白。</p><a class="text-link" href="/contact/">发现错误？提交纠正 <Icon name="arrow" size={16}/></a></div><div class="faq">{[['机场与 VPN 是一回事吗？','“机场”在这里指提供代理订阅的服务，VPN 通常通过官方应用或隧道配置工作。交付方式与客户端可能不同，应按具体服务文档确认。'],['这些优惠码都能使用吗？','代码由运营者提供，有效性、优惠幅度和适用套餐尚未核实。复制后请在结算页查看实际抵扣，再确认付款。'],['为什么没有速度或稳定性排名？','目前没有本网站独立实测记录。官方宣传、推广地址和优惠码不能证明服务质量，因此不生成性能名次。'],['品牌目录的顺序代表推荐吗？','目录按运营者提供的顺序整理，不代表质量或性价比排名。请结合实际套餐、服务条款和自己的任务核对。']].map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
</Layout>
