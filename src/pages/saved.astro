---
import Layout from '../layouts/Layout.astro';
import {getCollection} from 'astro:content';
import {orderArticles} from '../data/editorial';
const entries=orderArticles(await getCollection('articles',a=>!a.data.draft));
const labels:Record<string,string>={blog:'博客',guides:'教程',glossary:'术语'};
---
<Layout title="我的收藏与检查进度" description="在同一浏览器继续阅读主动收藏的文章，并找到保存的个人检查进度。无需账户，支持搜索、取消收藏与删除保存进度。" noindex={true} crumbs={[{name:'我的收藏',url:'/saved/'}]}><div class="container saved-workspace"><div class="page-intro"><span class="eyebrow">YOUR READING SPACE</span><h1>收藏的答案，下次接着用。</h1><p>收藏与检查进度仅保存在当前浏览器，不上传服务器。清除浏览器数据、使用其他设备或切换域名后不会同步；没有自动记录浏览历史。</p></div><div class="saved-toolbar"><div class="filter-tabs" role="group" aria-label="查看保存内容"><button type="button" data-saved-filter="favorites" aria-pressed="true">收藏文章</button><button type="button" data-saved-filter="progress" aria-pressed="false">检查进度</button></div><label class="directory-search"><span class="sr-only">搜索保存内容</span><input id="saved-query" type="search" placeholder="在保存内容中搜索"/></label></div><p id="saved-status" role="status" aria-live="polite">正在读取本设备保存内容…</p><div class="saved-empty empty" hidden><h2>这里还没有匹配内容</h2><p>在文章页点击“收藏这篇”，或在检查表下点击“保存检查进度”。有收藏但找不到时，可清空搜索或切换上方标签。</p><a class="button" href="/blog/">去知识库找答案 →</a><a class="text-link" href="/reading/">从阅读路线开始 ↗</a></div><ul class="saved-list">{entries.map(a=><li class="saved-entry" data-saved-url={`/${a.data.category}/${a.id}/`} data-saved-id={a.id} data-saved-search={`${a.data.title} ${a.data.description}`.toLowerCase()} hidden><div><span class="eyebrow">{labels[a.data.category]}</span><a href={`/${a.data.category}/${a.id}/`}><h2>{a.data.title}</h2></a><p>{a.data.description}</p><span class="saved-progress-label small"></span></div><div class="saved-entry-actions"><a href={`/${a.data.category}/${a.id}/`}>继续阅读 →</a><button type="button" data-remove-favorite>取消收藏</button><button type="button" data-remove-progress>删除保存进度</button></div></li>)}</ul><noscript><p class="notice">开启 JavaScript 后可读取本设备的收藏与进度；文章和阅读路线仍可直接浏览。</p></noscript></div></Layout>
<script>
 import {favorites,favoriteKey,writeLocal,readLocal,progressKey,validProgress,removeLocal} from '../lib/preferences';
 const entries=[...document.querySelectorAll<HTMLElement>('.saved-entry')];const input=document.querySelector<HTMLInputElement>('#saved-query')!;const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-saved-filter]')];let filter=new URLSearchParams(location.search).get('view')==='progress'?'progress':'favorites';
 function render(){const saved=favorites();let shown=0,total=0;entries.forEach(li=>{const url=li.dataset.savedUrl!,progress=validProgress(readLocal(progressKey(li.dataset.savedId!)));const present=filter==='favorites'?saved.includes(url):!!progress;if(present)total++;const visible=present&&input.value.trim().toLowerCase().split(/\s+/).every(w=>li.dataset.savedSearch!.includes(w));li.hidden=!visible;if(visible)shown++;const continueLink=li.querySelector<HTMLAnchorElement>('.saved-entry-actions>a')!;continueLink.href=url+(filter==='progress'?'#personal-checklist':'');continueLink.textContent=filter==='progress'?'继续检查 →':'继续阅读 →';li.querySelector<HTMLElement>('[data-remove-favorite]')!.hidden=!saved.includes(url);li.querySelector<HTMLElement>('[data-remove-progress]')!.hidden=!progress;li.querySelector('.saved-progress-label')!.textContent=progress?`已保存 ${progress.checked.filter(Boolean).length} / ${progress.checked.length} 项检查`:'尚未保存检查进度';});filters.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.savedFilter===filter)));document.querySelector('#saved-status')!.textContent=`${filter==='favorites'?'收藏文章':'已保存进度'} ${total} 篇 · 当前显示 ${shown} 篇`;document.querySelector<HTMLElement>('.saved-empty')!.hidden=shown>0;const locationUrl=new URL(location.href);if(filter==='progress')locationUrl.searchParams.set('view','progress');else locationUrl.searchParams.delete('view');history.replaceState(null,'',locationUrl);}
 entries.forEach(li=>{li.querySelector('[data-remove-favorite]')!.addEventListener('click',()=>{const ok=writeLocal(favoriteKey,favorites().filter(p=>p!==li.dataset.savedUrl));render();if(!ok)document.querySelector('#saved-status')!.textContent='当前浏览器不允许修改保存内容';});li.querySelector('[data-remove-progress]')!.addEventListener('click',()=>{const ok=removeLocal(progressKey(li.dataset.savedId!));render();if(!ok)document.querySelector('#saved-status')!.textContent='当前浏览器不允许删除保存进度';});});
 filters.forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.savedFilter!;render();}));input.addEventListener('input',render);window.addEventListener('storage',render);window.addEventListener('tizi-preferences',render);render();
</script>
