---
import Layout from '../../layouts/Layout.astro';
import {getCollection} from 'astro:content';
import {orderArticles} from '../../data/editorial';
import {blogTopics} from '../../data/blog-topics';
const articles=orderArticles(await getCollection('articles',a=>!a.data.draft));
const labels:Record<string,string>={blog:'博客',guides:'教程',glossary:'百科'};
const types=['all','blog','guides','glossary'];
---
<Layout title="搜索教程与知识文章" description="按标题、摘要和主题查找博客、设备教程与基础百科，支持多关键词、内容类型筛选和结果分页。" noindex={true} crumbs={[{name:'搜索',url:'/search/'}]}><div class="container search-workspace"><div class="page-intro"><span class="eyebrow">FIND YOUR ANSWER / 知识搜索</span><h1>找到你需要的答案</h1><p>从关键词开始，按博客、教程或百科缩小范围。</p></div>
 <form id="search-form" action="/search/" method="get" role="search"><label class="sr-only" for="query">搜索关键词</label><div class="search-field"><input id="query" class="search-input" type="search" name="q" placeholder="例如：订阅 格式、Windows、流量" autocomplete="off"/><button id="clear-query" type="button" aria-label="清空搜索关键词" hidden>清空</button><button class="button" type="submit">搜索</button></div></form>
 <div class="search-types" role="group" aria-label="内容类型">{types.map(type=><button type="button" data-type={type} aria-pressed={type==='all'}>{type==='all'?'全部内容':labels[type]}<span>{type==='all'?articles.length:articles.filter(a=>a.data.category===type).length}</span></button>)}</div>
 <p id="search-status" role="status" aria-live="polite">共 {articles.length} 篇文章，可按标题、摘要与主题查找。</p>
 <ul class="search-results" id="results">{articles.map(a=><li data-type={a.data.category} data-search={`${a.data.title} ${a.data.description} ${a.data.tags.join(' ')} ${blogTopics.find(t=>t.id===a.data.section)?.name??''}`.toLowerCase()}><a href={`/${a.data.category}/${a.id}/`}><span class="eyebrow">{labels[a.data.category]}{a.data.section?' · '+blogTopics.find(t=>t.id===a.data.section)?.name:''}</span><h2>{a.data.title}</h2><p>{a.data.description}</p><small class="muted">约 {Math.max(2,Math.ceil((a.body?.length??600)/400))} 分钟 · 更新 {a.data.updated.toISOString().slice(0,10)}</small></a></li>)}</ul>
 <div id="search-empty" class="empty" hidden><h2>没有匹配的文章</h2><p>试试缩短关键词，或切换到“全部内容”。</p></div>
 <nav class="search-pages" aria-label="搜索结果分页" hidden><button type="button" id="search-prev">← 上一页</button><span id="search-page"></span><button type="button" id="search-next">下一页 →</button></nav>
 </div><script>
 const input=document.querySelector<HTMLInputElement>('#query')!;
 const entries=[...document.querySelectorAll<HTMLElement>('#results li')];
 const types=[...document.querySelectorAll<HTMLButtonElement>('[data-type][aria-pressed]')];
 const clear=document.querySelector<HTMLButtonElement>('#clear-query')!;
 const previous=document.querySelector<HTMLButtonElement>('#search-prev')!;
 const next=document.querySelector<HTMLButtonElement>('#search-next')!;
 const params=new URLSearchParams(location.search);let scope=['blog','guides','glossary'].includes(params.get('scope')??'')?params.get('scope')!:'all';let page=1;const size=12;input.value=params.get('q')??'';
 function update(){const words=input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);const matching=entries.filter(li=>(scope==='all'||li.dataset.type===scope)&&words.every(word=>li.dataset.search!.includes(word)));const total=matching.length;const pages=Math.max(1,Math.ceil(total/size));page=Math.min(page,pages);const shown=new Set(matching.slice((page-1)*size,page*size));entries.forEach(li=>{li.hidden=!shown.has(li);});types.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.type===scope)));clear.hidden=!input.value;document.querySelector('#search-status')!.textContent=total?`找到 ${total} 篇文章 · 当前显示 ${(page-1)*size+1}–${Math.min(page*size,total)} 篇`:'没有匹配结果。';document.querySelector<HTMLElement>('#search-empty')!.hidden=total>0;document.querySelector<HTMLElement>('.search-pages')!.hidden=pages===1;document.querySelector('#search-page')!.textContent=`第 ${page} / ${pages} 页`;previous.disabled=page===1;next.disabled=page===pages;const url=new URL(location.href);url.searchParams.delete('q');url.searchParams.delete('scope');if(input.value.trim())url.searchParams.set('q',input.value.trim());if(scope!=='all')url.searchParams.set('scope',scope);history.replaceState(null,'',url);}
 input.addEventListener('input',()=>{page=1;update();});document.querySelector('#search-form')!.addEventListener('submit',event=>{event.preventDefault();page=1;update();});clear.addEventListener('click',()=>{input.value='';page=1;update();input.focus();});types.forEach(b=>b.addEventListener('click',()=>{scope=b.dataset.type!;page=1;update();}));previous.addEventListener('click',()=>{page--;update();});next.addEventListener('click',()=>{page++;update();});update();
 </script></Layout>
