---
import Layout from '../../layouts/Layout.astro';
import {getCollection} from 'astro:content';
import {orderArticles} from '../../data/editorial';
import {blogTopics} from '../../data/blog-topics';
import {airports} from '../../data/airports';
const articles=orderArticles(await getCollection('articles',a=>!a.data.draft));
const labels:Record<string,string>={blog:'博客',guides:'教程',glossary:'百科',brand:'品牌与优惠码'};
const types=['all','blog','guides','glossary','brand'];
---
<Layout title="搜索品牌、优惠码与知识文章" description="一次查找29个品牌、优惠码与164篇文章，支持多关键词、分类筛选和结果分页，返回后保留搜索位置。" noindex={true} crumbs={[{name:'搜索',url:'/search/'}]}><div class="container search-workspace"><div class="page-intro"><span class="eyebrow">FIND YOUR ANSWER / 知识搜索</span><h1>找到你需要的答案</h1><p>品牌、优惠码、教程和文章，一次搜索。多个关键词用空格分开；按 / 键可快速开始。</p></div>
 <form id="search-form" action="/search/" method="get" role="search"><label class="sr-only" for="query">搜索关键词</label><div class="search-field"><input id="query" class="search-input" type="search" name="q" placeholder="例如：微风、weifeng90、订阅 格式" autocomplete="off"/><button id="clear-query" type="button" aria-label="清空搜索关键词" hidden>清空</button><button class="button" type="submit">搜索</button></div></form><div class="search-examples" aria-label="常用搜索">{['订阅 格式','Windows','流量','微风','优惠码'].map(q=><button type="button" data-search-example={q}>{q} ↗</button>)}</div>
 <div class="search-types" role="group" aria-label="内容类型">{types.map(type=><button type="button" data-type={type} aria-pressed={type==='all'}>{type==='all'?'全部内容':labels[type]}<span>{type==='all'?articles.length+airports.length:type==='brand'?airports.length:articles.filter(a=>a.data.category===type).length}</span></button>)}</div>
 <p id="search-status" tabindex="-1" role="status" aria-live="polite">{articles.length} 篇文章与 {airports.length} 个品牌，可按名称、优惠码、标题和摘要查找。</p>
 <ul class="search-results" id="results">{articles.map(a=><li data-type={a.data.category} data-search={`${a.data.title} ${a.data.description} ${a.data.tags.join(' ')} ${blogTopics.find(t=>t.id===a.data.section)?.name??''}`.toLowerCase()}><a href={`/${a.data.category}/${a.id}/`}><span class="eyebrow">{labels[a.data.category]}{a.data.section?' · '+blogTopics.find(t=>t.id===a.data.section)?.name:''}</span><h2>{a.data.title}</h2><p>{a.data.description}</p><small class="muted">约 {Math.max(2,Math.ceil((a.body?.length??600)/400))} 分钟 · 更新 {a.data.updated.toISOString().slice(0,10)}</small></a></li>)}{airports.map(a=><li data-type="brand" data-search={`${a.name} ${a.slug} ${a.couponCode||''} ${a.couponCode?'优惠码':''}`.toLowerCase()}><a href={`/airport/${a.slug}/`}><span class="eyebrow">品牌入口与优惠资料</span><h2>{a.name}</h2><p>{a.couponCode?`优惠码：${a.couponCode}`:'暂无运营者提供的优惠码'}。入口与代码由运营者提供，优惠有效性及性能尚未核实。</p><small>查看品牌、公开来源与购买前待确认项 →</small></a></li>)}</ul>
 <div id="search-empty" class="empty" hidden><h2>没有匹配内容</h2><p>试试缩短关键词，或切换到“全部内容”。也可直接浏览品牌目录与阅读路线。</p></div>
 <p class="search-shortcuts"><a href="/airport/">按品牌筛选 ↗</a><a href="/reading/">按阅读路线查找 ↗</a><a href="/saved/">查看我的收藏 ↗</a></p><nav class="search-pages" aria-label="搜索结果分页" hidden><button type="button" id="search-prev">← 上一页</button><span id="search-page"></span><button type="button" id="search-next">下一页 →</button></nav>
 </div> <script>
 const input=document.querySelector<HTMLInputElement>('#query')!;const entries=[...document.querySelectorAll<HTMLElement>('#results li')];const types=[...document.querySelectorAll<HTMLButtonElement>('[data-type][aria-pressed]')];const clear=document.querySelector<HTMLButtonElement>('#clear-query')!;const previous=document.querySelector<HTMLButtonElement>('#search-prev')!,next=document.querySelector<HTMLButtonElement>('#search-next')!;let scope='all',page=1;const size=12;
 function hydrate(){const p=new URLSearchParams(location.search);input.value=p.get('q')??'';scope=['blog','guides','glossary','brand'].includes(p.get('scope')??'')?p.get('scope')!:'all';const n=Number(p.get('page'));page=Number.isSafeInteger(n)&&n>0?n:1;}
 function update(){const words=input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);const matching=entries.filter(li=>(scope==='all'||li.dataset.type===scope)&&words.every(w=>li.dataset.search!.includes(w)));const total=matching.length,pages=Math.max(1,Math.ceil(total/size));page=Math.min(page,pages);const shown=new Set(matching.slice((page-1)*size,page*size));entries.forEach(li=>li.hidden=!shown.has(li));types.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.type===scope)));clear.hidden=!input.value;document.querySelector('#search-status')!.textContent=total?'找到 '+total+' 条内容 · 当前显示 '+((page-1)*size+1)+'–'+Math.min(page*size,total)+' 条':'没有匹配结果。';document.querySelector<HTMLElement>('#search-empty')!.hidden=total>0;document.querySelector<HTMLElement>('.search-pages')!.hidden=pages===1;document.querySelector('#search-page')!.textContent='第 '+page+' / '+pages+' 页';previous.disabled=page===1;next.disabled=page===pages;const url=new URL(location.href);for(const key of ['q','scope','page'])url.searchParams.delete(key);if(input.value.trim())url.searchParams.set('q',input.value.trim());if(scope!=='all')url.searchParams.set('scope',scope);if(page>1)url.searchParams.set('page',String(page));history.replaceState(null,'',url);}
 const returnToResults=()=>{const status=document.querySelector<HTMLElement>('#search-status')!;status.focus({preventScroll:true});status.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});};
 input.addEventListener('input',()=>{page=1;update();});document.querySelector('#search-form')!.addEventListener('submit',e=>{e.preventDefault();page=1;update();});clear.addEventListener('click',()=>{input.value='';page=1;update();input.focus();});types.forEach(b=>b.addEventListener('click',()=>{scope=b.dataset.type!;page=1;update();}));document.querySelectorAll<HTMLButtonElement>('[data-search-example]').forEach(b=>b.addEventListener('click',()=>{input.value=b.dataset.searchExample!;scope='all';page=1;update();input.focus();}));previous.addEventListener('click',()=>{page--;update();returnToResults();});next.addEventListener('click',()=>{page++;update();returnToResults();});window.addEventListener('popstate',()=>{hydrate();update();});hydrate();update();if(location.hash==='#query')input.focus({preventScroll:true});
 </script></Layout>
